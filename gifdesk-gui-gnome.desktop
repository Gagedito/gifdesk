# Plantilla de referencia: edicion GNOME (GTK4 + libadwaita).
# install.sh genera el .desktop real con la ruta absoluta en Exec.
[Desktop Entry]
Type=Application
Version=1.0
Name=gifdesk gestor (GNOME)
Comment=Gestiona tus GIF/WebP flotantes (edicion GNOME, estilo Adwaita)
Exec=gifdesk-gui-gnome
Icon=image-x-generic
Terminal=false
StartupNotify=true
Categories=Utility;Graphics;
Keywords=gif;webp;animacion;widget;
