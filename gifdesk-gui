#!/usr/bin/env python3
# gifdesk-gui — gestora grafica de gifdesk (tkinter, solo stdlib).
# Galeria de GIF/WebP (anadir/borrar/mostrar) + modo editor
# (tamano, posicion, bloquear/desbloquear) + iniciar/detener.
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "gifdesk"
CONFIG_FILE = CONFIG_DIR / "gifdesk.conf"   # clasica (legado)
LEGACY_FILE = CONFIG_FILE
INST_DIR = CONFIG_DIR / "instances"
LIB_DIR = HOME / ".local" / "share" / "gifdesk" / "library"
BIN = shutil.which("gifdesk") or str(HOME / ".local" / "bin" / "gifdesk")

SUPPORTED = (".gif", ".webp")
PRESETS = ["BR", "BL", "TR", "TL", "C", "Personalizada..."]


def blank_cfg():
    return {"FILE": "", "MODE": "widget", "SIZE": "", "POS": "BR",
            "LOCKED": "no", "REV": "0", "OPACITY": "100"}


def inst_id(path):
    """Id base de instancia a partir de la ruta (tallo saneado)."""
    stem = Path(path).stem.lower().replace(" ", "-")
    clean = "".join(c for c in stem if c.isalnum() or c in ("-", "_"))[:32]
    clean = clean or "gif"
    return "main-gif" if clean == "main" else clean


def resolve_id(path):
    """Id estable y sin colisiones: si otro archivo usa el id base, sufija."""
    base = inst_id(path)
    me = str(path)
    iid, i = base, 0
    while True:
        conf = inst_conf(iid)
        if not conf.exists():
            return iid
        try:
            got = read_config(conf)["FILE"]
        except OSError:
            return iid
        if got in ("", me):
            return iid
        i += 1
        iid = f"{base}_{i}"


def inst_conf(iid):
    return INST_DIR / f"{iid}.conf"


def bump_rev(path):
    """Siguiente REV de una conf (= cambio explicito del editor).
    La regla KWin solo se reescribe si la REV cambia; lo recordado se respeta."""
    p = Path(path)
    try:
        lines = p.read_text().splitlines() if p.exists() else []
    except OSError:
        lines = []
    rev = 0
    out = []
    for ln in lines:
        if re.match(r"^\s*REV=", ln):
            try:
                rev = int(re.sub(r"\D", "", ln.split("=", 1)[1]) or 0)
            except ValueError:
                rev = 0
            continue
        out.append(ln)
    out.append(f"REV={rev + 1}")
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text("\n".join(out) + "\n")
    return rev + 1


def read_config(path=None):
    cfg = blank_cfg()
    try:
        for line in (path or CONFIG_FILE).read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            k, v = k.strip(), v.strip().strip('"')
            if k in cfg:
                cfg[k] = v
    except FileNotFoundError:
        pass
    if cfg["LOCKED"] not in ("yes", "no"):
        cfg["LOCKED"] = "no"
    if not re.match(r"^\d+$", cfg.get("REV", "")):
        cfg["REV"] = "0"
    try:
        op = int(cfg.get("OPACITY", "100"))
    except (TypeError, ValueError):
        op = 100
    cfg["OPACITY"] = str(max(0, min(100, op)))
    if cfg["POS"] not in ("TL", "TR", "BL", "BR", "C") and "," not in cfg["POS"]:
        cfg["POS"] = "BR"
    return cfg


def write_config(cfg, path=None):
    dest = path or CONFIG_FILE
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text(
        "# gifdesk — configuracion (la usa 'gifdesk --autostart')\n"
        f'FILE="{cfg["FILE"]}"\n'
        f'MODE={cfg.get("MODE", "widget")}\n'
        f'SIZE={cfg.get("SIZE", "")}\n'
        f'POS={cfg.get("POS", "BR")}\n'
        f'LOCKED={cfg.get("LOCKED", "no")}\n'
        f'REV={cfg.get("REV", "0")}\n'
        f'OPACITY={cfg.get("OPACITY", "100")}\n'
    )


def run_gifdesk(*args):
    try:
        p = subprocess.run([BIN, *args], capture_output=True, text=True, timeout=15)
        return p.returncode, (p.stdout + p.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, str(e)


def is_running():
    rc, _ = run_gifdesk("--status")
    return rc == 0


def run_inst(iid, *args):
    """Ejecuta gifdesk sobre una instancia (id de la galeria)."""
    if iid:
        return run_gifdesk("--id", iid, *args)
    return run_gifdesk(*args)


def is_running_inst(iid):
    rc, _ = run_inst(iid, "--status")
    return rc == 0


def send_ipc_sock(sockname, *args):
    """Un comando al socket IPC indicado. Dict con 'error' si falla."""
    import json as _json
    import socket as _socket
    base = Path(os.environ.get("XDG_CACHE_HOME",
                               os.path.join(str(Path.home()), ".cache")))
    s = None
    try:
        s = _socket.socket(_socket.AF_UNIX)
        s.settimeout(3)
        s.connect(str(base / "gifdesk" / sockname))
        s.sendall((_json.dumps({"command": list(args)}) + "\n").encode())
        line = s.makefile().readline()
        return _json.loads(line) if line else {}
    except (OSError, ValueError):
        return {"error": "sin conexion"}
    finally:
        if s is not None:
            try:
                s.close()
            except OSError:
                pass


def live_lock(iid, lock):
    """Aplica bloqueo en vivo (sin relanzar ni mover). True si quedo puesto."""
    sock = f"socket-{iid}"
    want_pt, want_cur = (True, False) if lock else (False, True)
    r1 = send_ipc_sock(sock, "set_property", "input-cursor-passthrough", want_pt)
    r2 = send_ipc_sock(sock, "set_property", "input-cursor", want_cur)
    if r1.get("error") != "success" or r2.get("error") != "success":
        return False
    g1 = send_ipc_sock(sock, "get_property", "input-cursor-passthrough")
    g2 = send_ipc_sock(sock, "get_property", "input-cursor")
    try:
        return bool(g1.get("data")) == want_pt and bool(g2.get("data")) == want_cur
    except (TypeError, ValueError, AttributeError):
        return False


def file_info(path):
    """(etiqueta) con dimensiones/cuadros via ffprobe, o tamano si falla."""
    w, h, frames = media_dims(path)
    if w and h:
        extra = f", {frames}f" if frames else ""
        return f"{w}x{h}{extra}"
    try:
        kb = Path(path).stat().st_size // 1024
        return f"{kb} KB"
    except OSError:
        return "?"


def media_dims(path):
    """(ancho, alto, cuadros|None) via ffprobe. Funciones puras, testeables."""
    try:
        p = subprocess.run(
            ["ffprobe", "-v", "error", "-select_streams", "v:0",
             "-show_entries", "stream=width,height,nb_frames",
             "-of", "csv=p=0", str(path)],
            capture_output=True, text=True, timeout=10)
        parts = p.stdout.strip().split(",")
        if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
            frames = int(parts[2]) if len(parts) > 2 and parts[2].isdigit() else None
            return int(parts[0]), int(parts[1]), frames
    except (OSError, subprocess.SubprocessError):
        pass
    return None, None, None


def scale_size(size_str, factor, minimum=64):
    """Escala 'WxH' por factor (rueda del raton). '' = nativo: se mantiene."""
    if not size_str or "x" not in size_str.lower():
        return ""
    try:
        w, h = size_str.lower().split("x", 1)
        w, h = max(minimum, round(int(w) * factor)), max(minimum, round(int(h) * factor))
        return f"{w}x{h}"
    except ValueError:
        return size_str


def clamp_xy(x, y):
    """La posicion mpv no admite negativos: recorta a 0."""
    return max(0, int(x)), max(0, int(y))


def gif_durations(path, maxframes=300):
    """Duraciones por cuadro (ms) via Pillow. [] si no se puede leer."""
    try:
        from PIL import Image
        im = Image.open(path)
        durs = []
        n = min(getattr(im, "n_frames", 1), maxframes)
        for i in range(max(1, n)):
            try:
                im.seek(i)
            except Exception:
                break
            d = im.info.get("duration") or 100
            durs.append(max(20, min(int(d), 2000)))
        return durs
    except Exception:
        return []


def webp_animation(path, maxwh=220, maxframes=200):
    """(frames PIL RGBA, duraciones ms, animado?) para WebP.
    Estatico -> ([img], [0], False). Falla -> ([], [], False)."""
    try:
        from PIL import Image
        im = Image.open(path)
        if not getattr(im, "is_animated", False):
            one = im.convert("RGBA")
            one.thumbnail((maxwh, maxwh), Image.LANCZOS)
            return [one], [0], False
        frames, durs = [], []
        for i in range(min(im.n_frames, maxframes)):
            try:
                im.seek(i)
            except Exception:
                break
            fr = im.convert("RGBA")
            fr.thumbnail((maxwh, maxwh), Image.LANCZOS)
            frames.append(fr)
            durs.append(max(20, min(int(im.info.get("duration") or 100), 2000)))
        return frames, durs, bool(frames)
    except Exception:
        return [], [], False


def preview_cache_key(path):
    """Clave estable por contenido (renombres no duplican cache)."""
    import hashlib
    try:
        h = hashlib.sha1()
        with open(path, "rb") as f:
            for blk in iter(lambda: f.read(1 << 20), b""):
                h.update(blk)
        return h.hexdigest()[:16]
    except OSError:
        return None


def preview_cache_dir():
    base = Path(os.environ.get("XDG_CACHE_HOME",
                               os.path.join(str(Path.home()), ".cache")))
    d = base / "gifdesk" / "preview"
    d.mkdir(parents=True, exist_ok=True)
    return d


def preview_build(path, maxwh=220):
    """Extrae PNGs pequenos + duraciones. (pngs, durs, animado?).
    Correcto por construccion (ffmpeg maneja disposal). Lento: usar en hilo.
    Si ya esta en cache de disco, es rapido."""
    try:
        key = preview_cache_key(path)
        if not key:
            return [], [], False
        outdir = preview_cache_dir() / key
        durf = outdir / "durations.txt"
        if outdir.is_dir() and durf.exists():
            pngs = sorted(outdir.glob("f*.png"))
            if pngs:
                durs = [int(x) for x in durf.read_text().split()]
                return pngs, durs, len(pngs) > 1
        outdir.mkdir(parents=True, exist_ok=True)
        r = subprocess.run(
            ["ffmpeg", "-v", "error", "-y", "-i", str(path), "-vf",
             f"scale={maxwh}:{maxwh}:force_original_aspect_ratio=decrease",
             str(outdir / "f%03d.png")],
            capture_output=True, timeout=120)
        if r.returncode != 0:
            return [], [], False
        pngs = sorted(outdir.glob("f*.png"))
        if not pngs:
            return [], [], False
        durs = gif_durations(str(path)) or [100] * len(pngs)
        durs = (durs + [100] * len(pngs))[:len(pngs)]
        durf.write_text(" ".join(str(int(x)) for x in durs))
        return pngs, durs, len(pngs) > 1
    except Exception:
        return [], [], False


def unique_dest(name):
    dest = LIB_DIR / name
    if not dest.exists():
        return dest
    stem, suf = os.path.splitext(name)
    i = 1
    while True:
        cand = LIB_DIR / f"{stem}_{i}{suf}"
        if not cand.exists():
            return cand
        i += 1


def main():
    import threading
    import tkinter as tk
    from tkinter import filedialog, messagebox

    LIB_DIR.mkdir(parents=True, exist_ok=True)
    INST_DIR.mkdir(parents=True, exist_ok=True)
    cfg = blank_cfg()
    cur = {"id": None}  # instancia seleccionada (una por GIF, independientes)

    # Errores de callbacks Tk a fichero (al abrir por menu, stderr se pierde).
    def _log_err(exc, val, tb):
        try:
            import traceback
            logp = Path(os.environ.get("XDG_CACHE_HOME",
                                       os.path.join(str(Path.home()), ".cache")))
            logp = logp / "gifdesk" / "gui.log"
            with open(logp, "a") as f:
                f.write(traceback.format_exception(exc, val, tb))
        except Exception:
            pass

    def cur_id():
        return cur["id"]

    root = tk.Tk()
    root.title("gifdesk — gestor")
    root.geometry("880x640")
    root.minsize(720, 520)

    status_var = tk.StringVar(value="")

    def set_status(msg):
        status_var.set(msg)
        root.update_idletasks()

    def in_thread(done, fn, *args):
        """Ejecuta fn en hilo (subprocesos bloqueantes) y llama done(res)
        en el hilo de Tk. done siempre corre en main thread (seguro)."""
        def run():
            try:
                res = fn(*args)
            except Exception as e:  # noqa: BLE001
                res = (1, str(e))
            root.after(0, lambda: done(res))
        threading.Thread(target=run, daemon=True).start()

    def refresh_status_line():
        iid = cur_id()
        if iid and is_running_inst(iid):
            set_status(f"Estado: {iid} mostrando en pantalla")
        elif iid:
            set_status(f"Estado: {iid} detenido")
        else:
            set_status("Estado: sin seleccion")

    # ---------- galeria ----------
    left = tk.LabelFrame(root, text="Galeria (libreria)", padx=6, pady=6)
    left.pack(side="left", fill="both", expand=True, padx=6, pady=6)

    lib_list = tk.Listbox(left, width=32)
    lib_list.pack(fill="both", expand=True)

    detail_var = tk.StringVar(value="Selecciona un archivo")
    tk.Label(left, textvariable=detail_var, anchor="w", justify="left").pack(fill="x")
    preview = tk.Label(left, text="(sin vista previa)")
    preview.pack(pady=4)
    preview_img = {"img": None}  # refs para que no las libere el GC
    preview_play = {"job": None, "frames": [], "durs": [], "idx": 0, "key": 0}
    preview_cache = {}  # ruta -> (photos, durs): revisitar es instantaneo

    def stop_preview():
        preview_play["key"] += 1
        if preview_play["job"] is not None:
            try:
                root.after_cancel(preview_play["job"])
            except Exception:
                pass
            preview_play["job"] = None
        preview_play["frames"] = []
        preview_img["img"] = None

    def play_preview(frames, durs):
        """Anima frames (PhotoImage) con sus duraciones. Sin frames = nada."""
        stop_preview()
        if not frames:
            preview.config(image="", text="(sin vista previa)")
            return
        key = preview_play["key"] + 1
        preview_play.update(key=key, frames=frames, durs=durs or [100] * len(frames),
                            idx=0)

        def tick(k):
            if k != preview_play["key"]:
                return
            fr = preview_play["frames"]
            if not fr:
                return
            i = preview_play["idx"] % len(fr)
            preview_img["img"] = fr[i]
            preview.config(image=fr[i], text="")
            preview_play["idx"] = i + 1
            dd = preview_play["durs"]
            d = dd[i % len(dd)] if dd else 100
            preview_play["job"] = root.after(max(20, d), lambda: tick(k))

        tick(key)

    def library_files():
        return sorted(
            (p for p in LIB_DIR.iterdir()
             if p.is_file() and p.suffix.lower() in SUPPORTED),
            key=lambda p: p.name.lower())

    def refresh_list(select=None):
        # Sin seleccion explicita, conservar la actual (no saltar al 1).
        if select is None:
            p0 = selected_path()
            select = p0.name if p0 else None
        lib_list.delete(0, tk.END)
        files = library_files()
        sel_idx = None
        for i, p in enumerate(files):
            iid = resolve_id(p)
            mark = "  [on]" if is_running_inst(iid) else ""
            lib_list.insert(tk.END, f"{p.name}{mark}")
            if select is not None and p.name == select:
                sel_idx = i
        if sel_idx is not None:
            lib_list.selection_set(sel_idx)
            lib_list.see(sel_idx)
        elif files and not lib_list.curselection():
            lib_list.selection_set(0)
        on_select()

    def selected_path():
        sel = lib_list.curselection()
        files = library_files()
        if not sel or sel[0] >= len(files):
            return None
        return files[sel[0]]

    def load_selection():
        """Carga en el editor la config propia del GIF seleccionado."""
        p = selected_path()
        if p is None:
            cur["id"] = None
            cfg.clear()
            cfg.update(blank_cfg())
        else:
            cur["id"] = resolve_id(p)
            cfg.clear()
            cfg.update(read_config(inst_conf(cur["id"])))
            if not cfg["FILE"]:
                cfg["FILE"] = str(p)
        sync_editor_from_config()
        refresh_lock()
        refresh_current()
        refresh_status_line()

    def on_select(*_a):
        p = selected_path()
        stop_preview()
        if p is None:
            detail_var.set("Libreria vacia: usa Anadir")
            preview.config(image="", text="(sin vista previa)")
            load_selection()
            return
        detail_var.set(f"{p.name}\n{file_info(p)}")
        key = str(p)
        if key in preview_cache:
            photos, durs = preview_cache[key]
            if len(photos) > 1:
                play_preview(photos, durs)
            elif photos:
                preview_img["img"] = photos[0]
                preview.config(image=photos[0], text="")
            else:
                preview.config(image="", text="(no se pudo leer)")
            load_selection()
            return
        # Primer cuadro al instante (1 sola decodificacion Tk).
        try:
            first = tk.PhotoImage(file=key)
            f = max(first.width() // 220, first.height() // 220, 1)
            if f > 1:
                first = first.subsample(f, f)
            preview_img["img"] = first
            preview.config(image=first, text="")
        except Exception:
            pass
        load_selection()

        # Resto en hilo: ffmpeg extrae PNGs (correcto y sin congelar).
        def build():
            try:
                return preview_build(key)
            except Exception:
                return [], [], False

        def built(res):
            pngs, durs, animated = res
            if not pngs:
                return
            try:
                photos = [tk.PhotoImage(file=str(x)) for x in pngs]
            except tk.TclError:
                return
            preview_cache[key] = (photos, durs)
            while len(preview_cache) > 4:
                preview_cache.pop(next(iter(preview_cache)))
            sel = selected_path()
            if sel is None or str(sel) != key:
                return  # ya mira otro
            if animated and len(photos) > 1:
                play_preview(photos, durs)
            elif photos:
                preview_img["img"] = photos[0]
                preview.config(image=photos[0], text="")

        in_thread(lambda r: built(r), build)

    def do_add():
        src = filedialog.askopenfilename(
            title="Anadir GIF / WebP",
            filetypes=[("GIF/WebP", "*.gif *.webp *.GIF *.WEBP")])
        if not src:
            return
        if Path(src).suffix.lower() not in SUPPORTED:
            messagebox.showerror("gifdesk", "Solo .gif / .webp")
            return
        dest = unique_dest(Path(src).name)
        try:
            shutil.copy2(src, dest)
        except OSError as e:
            messagebox.showerror("gifdesk", f"No se pudo copiar:\n{e}")
            return
        refresh_list(select=dest.name)
        set_status(f"Anadido: {dest.name}")

    def adopt_legacy(p, full=False):
        """La GUI gestiona instancias; la config clasica con FILE duplicaria
        ventanas en autostart. En do_show (full) se vacia siempre y se para
        si corre; en el resto solo si coincide con la seleccion."""
        legacy = read_config(LEGACY_FILE)
        if not legacy["FILE"]:
            return
        if full or legacy["FILE"] == str(p):
            if run_gifdesk("--status")[0] == 0:
                run_gifdesk("--stop")
            legacy["FILE"] = ""
            write_config(legacy, LEGACY_FILE)

    def do_delete():
        p = selected_path()
        if p is None:
            return
        if not messagebox.askyesno("gifdesk", f"Borrar de la libreria?\n{p.name}"):
            return
        iid = resolve_id(p)
        run_inst(iid, "--stop")
        try:
            inst_conf(iid).unlink(missing_ok=True)
        except OSError:
            pass
        try:
            p.unlink()
        except OSError as e:
            messagebox.showerror("gifdesk", f"No se pudo borrar:\n{e}")
            return
        refresh_list()
        set_status(f"Borrado: {p.name} (instancia {iid} eliminada)")

    def do_show():
        p = selected_path()
        if p is None:
            return
        iid = resolve_id(p)
        cur["id"] = iid
        cfg["FILE"] = str(p)
        write_config(cfg, inst_conf(iid))
        bump_rev(inst_conf(iid))  # archivo (nuevo) = orden explicita
        adopt_legacy(p, full=True)
        refresh_current()
        refresh_list(select=p.name)
        set_status("Mostrando... (sin bloquear la ventana)")

        def done(res):
            rc, out = res
            if rc != 0:
                messagebox.showerror("gifdesk", f"No se pudo mostrar:\n{out}")
            refresh_list(select=p.name)
            refresh_status_line()

        in_thread(done, run_inst, iid, "--autostart")

    btns = tk.Frame(left)
    btns.pack(fill="x", pady=4)
    tk.Button(btns, text="Anadir", command=do_add).pack(side="left", expand=True, fill="x")
    tk.Button(btns, text="Borrar", command=do_delete).pack(side="left", expand=True, fill="x")
    tk.Button(btns, text="Mostrar", command=do_show).pack(side="left", expand=True, fill="x")
    lib_list.bind("<<ListboxSelect>>", on_select)
    lib_list.bind("<Double-Button-1>", lambda _e: do_show())

    # ---------- editor (con scroll: entra a cualquier tamano) ----------
    right_outer = tk.LabelFrame(root, text="Modo editor", padx=6, pady=6)
    right_outer.pack(side="right", fill="both", expand=True, padx=6, pady=6)
    right_canvas = tk.Canvas(right_outer, highlightthickness=0)
    right_scroll = tk.Scrollbar(right_outer, orient="vertical",
                                command=right_canvas.yview)
    right_canvas.configure(yscrollcommand=right_scroll.set)
    right_scroll.pack(side="right", fill="y")
    right_canvas.pack(side="left", fill="both", expand=True)
    right = tk.Frame(right_canvas)
    right_win = right_canvas.create_window((0, 0), window=right, anchor="nw")

    def _right_scroll_cfg(_ev=None):
        right_canvas.configure(scrollregion=right_canvas.bbox("all"))
        right_canvas.itemconfig(right_win, width=right_canvas.winfo_width())

    right.bind("<Configure>", lambda _e: right_canvas.after_idle(_right_scroll_cfg))
    right_canvas.bind("<Configure>", lambda _e: right_canvas.after_idle(_right_scroll_cfg))
    # Rueda sobre el editor hace scroll (sin robar la de posicion).
    right_canvas.bind_all("<Button-4>",
                         lambda e: right_canvas.yview_scroll(-1, "units")
                         if str(e.widget).startswith(str(right_outer)) else None)
    right_canvas.bind_all("<Button-5>",
                         lambda e: right_canvas.yview_scroll(1, "units")
                         if str(e.widget).startswith(str(right_outer)) else None)

    cur_var = tk.StringVar(value="")
    tk.Label(right, text="Archivo actual:").pack(anchor="w")
    tk.Label(right, textvariable=cur_var, wraplength=280, justify="left",
             fg="blue").pack(anchor="w")

    def refresh_current():
        f = cfg["FILE"]
        base = Path(f).name if f else "(ninguno)"
        iid = cur_id()
        cur_var.set(f"{base}  [instancia: {iid}]" if iid else base)

    tk.Label(right, text="Resolucion (ancho x alto):").pack(anchor="w", pady=(8, 0))
    size_row = tk.Frame(right)
    size_row.pack(anchor="w")
    w_var = tk.StringVar(value="")
    h_var = tk.StringVar(value="")
    tk.Entry(size_row, textvariable=w_var, width=6).pack(side="left")
    tk.Label(size_row, text=" x ").pack(side="left")
    tk.Entry(size_row, textvariable=h_var, width=6).pack(side="left")
    def do_nativo():
        """Rellena con la resolucion real, pone el slider en 100 y aplica
        al instante (el GIF vuelve a su tamano real ahi mismo)."""
        if cfg.get("FILE"):
            w0, h0, _ = media_dims(cfg["FILE"])
            if w0 and h0:
                w_var.set(str(w0))
                h_var.set(str(h0))
            else:
                w_var.set("")
                h_var.set("")
        else:
            w_var.set("")
            h_var.set("")
        pct_var.set(100)
        do_apply()

    tk.Button(size_row, text="Nativo",
              command=do_nativo).pack(side="left", padx=4)

    tk.Label(right, text="Tamano en % (100 = real):").pack(anchor="w")
    pct_var = tk.IntVar(value=100)

    def on_pct(_v):
        if not cfg.get("FILE"):
            return
        w0, h0, _ = media_dims(cfg["FILE"])
        if w0 and h0:
            p = pct_var.get()
            w_var.set(str(max(48, round(w0 * p / 100))))
            h_var.set(str(max(48, round(h0 * p / 100))))

    tk.Scale(right, from_=25, to=200, orient="horizontal", length=220,
             variable=pct_var, command=on_pct).pack(anchor="w")

    tk.Label(right, text="Opacidad % (100 = opaco, 0 = invisible):").pack(anchor="w")
    opa_var = tk.IntVar(value=100)
    tk.Scale(right, from_=0, to=100, orient="horizontal", length=220,
             variable=opa_var).pack(anchor="w")

    tk.Label(right, text="Posicion:").pack(anchor="w", pady=(8, 0))
    pos_var = tk.StringVar(value=cfg["POS"] if cfg["POS"] in PRESETS[:5] else "Personalizada...")
    pos_menu = tk.OptionMenu(right, pos_var, *PRESETS)
    pos_menu.pack(anchor="w")
    xy_row = tk.Frame(right)
    xy_row.pack(anchor="w")
    x_var = tk.StringVar(value="")
    y_var = tk.StringVar(value="")
    tk.Label(xy_row, text="X:").pack(side="left")
    tk.Entry(xy_row, textvariable=x_var, width=6).pack(side="left")
    tk.Label(xy_row, text="Y:").pack(side="left")
    tk.Entry(xy_row, textvariable=y_var, width=6).pack(side="left")

    def sync_editor_from_config():
        size = cfg.get("SIZE", "")
        if size and "x" in size.lower():
            w, h = size.lower().split("x", 1)
            w_var.set(w.strip()); h_var.set(h.strip())
        else:
            w_var.set(""); h_var.set("")
        # El % refleja lo guardado (100 = nativo). Sin esto siempre marcaba 100.
        try:
            w0, h0, _ = media_dims(cfg["FILE"]) if cfg.get("FILE") else (None, None, None)
            if size and "x" in size.lower() and w0 and h0:
                w, h = size.lower().split("x", 1)
                p = round(int(w.strip()) * 100 / w0)
                pct_var.set(max(25, min(200, p)))
            else:
                pct_var.set(100)
        except (ValueError, ZeroDivisionError):
            pct_var.set(100)
        try:
            opa_var.set(int(cfg.get("OPACITY", "100")))
        except (TypeError, ValueError):
            opa_var.set(100)
        pos = cfg.get("POS", "BR")
        if pos in PRESETS[:5]:
            pos_var.set(pos)
        else:
            pos_var.set("Personalizada...")
            if "," in pos:
                x, y = pos.split(",", 1)
                x_var.set(x.strip()); y_var.set(y.strip())

    def do_apply():
        w, h = w_var.get().strip(), h_var.get().strip()
        if (w or h) and not (w.isdigit() and h.isdigit()):
            messagebox.showerror("gifdesk", "Ancho/alto deben ser numeros (o vacio = nativo)")
            return
        cfg["SIZE"] = f"{w}x{h}" if w and h else ""
        pv = pos_var.get()
        if pv == "Personalizada...":
            x, y = x_var.get().strip(), y_var.get().strip()
            if not (x.isdigit() and y.isdigit()):
                messagebox.showerror("gifdesk", "X/Y deben ser numeros")
                return
            cfg["POS"] = f"{x},{y}"
        else:
            cfg["POS"] = pv
        cfg["OPACITY"] = str(max(0, min(100, opa_var.get())))
        iid = cur_id()
        if iid is None:
            messagebox.showinfo("gifdesk", "Selecciona un GIF de la galeria")
            return
        adopt_legacy(cfg.get("FILE", ""))
        # Relanzar SOLO si cambio algo que lo exige: si no, el relanzado
        # devolveria al GIF a su sitio para nada. Solo-opacidad va por regla
        # en vivo (forzar), sin relanzar ni mover.
        disk = read_config(inst_conf(iid))
        changed = {k for k in ("SIZE", "MODE", "POS", "OPACITY")
                   if cfg.get(k, "") != disk.get(k, "")}
        write_config(cfg, inst_conf(iid))
        if changed:
            bump_rev(inst_conf(iid))  # orden explicita: la regla se reescribe
        if not cfg["FILE"]:
            messagebox.showinfo("gifdesk", "Sin archivo actual: elige uno y pulsa Mostrar")
            return
        if not changed and is_running_inst(iid):
            refresh_status_line()
            set_status(f"Sin cambios (sigue igual @ {cfg['POS'] or 'nativo'})")
            return
        # Solo opacidad: regla en vivo, sin relanzar (conserva el sitio).
        if changed == {"OPACITY"} and is_running_inst(iid):
            set_status("Aplicando opacidad en vivo...")

            def done_op(res):
                rc, out = res
                if rc != 0:
                    messagebox.showerror("gifdesk", f"No se pudo aplicar:\n{out}")
                else:
                    set_status(f"Opacidad: {cfg['OPACITY']}% (sin mover)")
                sync_editor_from_config()
                refresh_status_line()

            in_thread(done_op, run_inst, iid, "--rule-only")
            return
        set_status("Aplicando... (sin bloquear la ventana)")
        if not cfg["FILE"]:
            messagebox.showinfo("gifdesk", "Sin archivo actual: elige uno y pulsa Mostrar")
            return
        if not changed and is_running_inst(iid):
            refresh_status_line()
            set_status(f"Sin cambios (sigue igual @ {cfg['POS'] or 'nativo'})")
            return
        # Bloquear el boton mientras aplica: dos Aplicar seguidos lanzaban
        # carreras (regla/conf/rev desfasados, p. ej. opacidad atascada).
        apply_btn.config(state="disabled")
        set_status("Aplicando... (sin bloquear la ventana)")

        def done(res):
            rc, out = res
            if rc != 0:
                messagebox.showerror("gifdesk", f"No se pudo aplicar:\n{out}")
            else:
                set_status(f"Aplicado: {cfg['SIZE'] or 'nativo'} @ {cfg['POS']}")
            sync_editor_from_config()
            refresh_status_line()
            try:
                apply_btn.config(state="normal")
            except tk.TclError:
                pass

        in_thread(done, run_inst, iid, "--autostart")

    apply_btn = tk.Button(right, text="Aplicar cambios", command=do_apply)
    apply_btn.pack(anchor="w", pady=6)

    lock_var = tk.StringVar(value="")
    tk.Label(right, textvariable=lock_var).pack(anchor="w")
    lock_btn = tk.Button(right, text="")

    def refresh_lock():
        locked = cfg.get("LOCKED", "no") == "yes"
        lock_var.set("Posicion: BLOQUEADA (ignora el raton)" if locked
                     else "Posicion: libre (se puede mover)")
        lock_btn.config(text="Desbloquear posicion" if locked else "Bloquear posicion")

    def running_ids():
        """Ids con ventana mostrandose (parsea gifdesk --list)."""
        rc, out = run_gifdesk("--list")
        ids = []
        if rc == 0:
            for line in out.splitlines():
                parts = line.split()
                if len(parts) >= 2 and parts[1] == "corriendo":
                    ids.append(parts[0])
        return ids

    def apply_live_geometry(iid):
        """Lee X Y W H reales (kdotool) y los guarda en la config + bump.
        Devuelve (x, y, w, h) o None si no se ve."""
        rc, out = run_inst(iid, "--where")
        if rc != 0:
            return None
        parts = out.split()
        if len(parts) != 5:
            return None
        _title, x, y, w, h = parts
        if not (x.lstrip("-").isdigit() and y.lstrip("-").isdigit()
                and w.isdigit() and h.isdigit()):
            return None
        x, y = max(0, int(x)), max(0, int(y))
        w, h = max(48, int(w)), max(48, int(h))
        cfg["POS"] = f"{x},{y}"
        cfg["SIZE"] = f"{w}x{h}"
        write_config(cfg, inst_conf(iid))
        bump_rev(inst_conf(iid))
        return x, y, w, h

    def do_fix_position():
        """Fija la posicion/tamano ACTUALES (donde lo arrastraste)."""
        iid = cur_id()
        if iid is None:
            messagebox.showinfo("gifdesk", "Selecciona un GIF de la galeria")
            return
        if not is_running_inst(iid):
            messagebox.showinfo("gifdesk", "Ese GIF no se esta mostrando")
            return
        got = apply_live_geometry(iid)
        if got is None:
            messagebox.showinfo(
                "gifdesk",
                "No veo la ventana (falta kdotool o no esta visible).\n"
                "Instala: sudo pacman -S kdotool")
            return
        x, y, w, h = got
        sync_editor_from_config()
        refresh_status_line()
        set_status(f"Fijado donde esta: {w}x{h} @ {x},{y}")

    def do_lock_toggle():
        iid = cur_id()
        if iid is None:
            messagebox.showinfo("gifdesk", "Selecciona un GIF de la galeria")
            return
        if not is_running_inst(iid):
            others = [i for i in running_ids() if i != iid]
            if others:
                messagebox.showinfo(
                    "gifdesk",
                    f"'{iid}' no se esta mostrando.\n"
                    f"Mostrandose: {', '.join(others)}.\n"
                    "Selecciona en la galeria el que tocas (mira [on]).")
            else:
                messagebox.showinfo("gifdesk", "Ningun GIF se esta mostrando")
            refresh_status_line()
            return
        new_lock = "no" if cfg.get("LOCKED") == "yes" else "yes"
        lock = (new_lock == "yes")
        set_status(f"{'Bloqueando' if lock else 'Desbloqueando'} {iid}...")

        def work():
            # Hilo: capturar sitio + guardar + IPC en vivo (nada bloquea la GUI).
            live = apply_live_geometry(iid)
            cfg["LOCKED"] = new_lock
            adopt_legacy(cfg.get("FILE", ""))
            write_config(cfg, inst_conf(iid))
            if live is None:
                bump_rev(inst_conf(iid))
            if live_lock(iid, lock):
                return ("live", None)
            return ("relaunch", None)

        def done(res):
            kind, _out = res
            if kind == "live":
                verb = "Bloqueado" if lock else "Desbloqueado"
                set_status(f"{verb} {iid} donde esta (en vivo)")
            else:
                set_status("Sin respuesta en vivo, relanzando...")

                def done2(res2):
                    rc, out = res2
                    if rc != 0:
                        messagebox.showerror("gifdesk", f"No se pudo aplicar:\n{out}")
                    else:
                        verb = "Bloqueado" if lock else "Desbloqueado"
                        set_status(f"{verb} {iid} en su sitio ({cfg['POS'] or 'BR'})")
                    refresh_lock()
                    refresh_status_line()
                    sync_editor_from_config()

                in_thread(done2, run_inst, iid, "--autostart")
                return
            refresh_lock()
            refresh_status_line()
            sync_editor_from_config()

        in_thread(done, work)

    lock_btn.config(command=do_lock_toggle)
    lock_btn.pack(anchor="w")
    tk.Button(right, text="Fijar posicion actual",
              command=do_fix_position).pack(anchor="w")
    tk.Label(right, text="Sobre el GIF: arrastra para mover.\nTamano con el % del editor.",
             wraplength=280, justify="left").pack(anchor="w")

    ctl = tk.Frame(right)
    ctl.pack(anchor="w", pady=(10, 0))

    def do_start():
        iid = cur_id()
        if not cfg["FILE"] or iid is None:
            messagebox.showinfo("gifdesk", "Elige un archivo y pulsa Mostrar")
            return
        adopt_legacy(cfg["FILE"])
        write_config(cfg, inst_conf(iid))
        set_status("Iniciando...")

        def done(res):
            refresh_list()
            refresh_status_line()

        in_thread(done, run_inst, iid, "--autostart")

    def do_stop():
        iid = cur_id()
        set_status("Deteniendo...")

        def done(_res):
            refresh_list()
            refresh_status_line()

        if iid is None:
            done((0, ""))
        else:
            in_thread(done, run_inst, iid, "--stop")

    tk.Button(ctl, text="Iniciar", command=do_start).pack(side="left")
    tk.Button(ctl, text="Detener", command=do_stop).pack(side="left")

    tk.Label(right, textvariable=status_var, wraplength=280,
             justify="left").pack(anchor="w", pady=(10, 0))

    # init
    refresh_list()
    refresh_current()
    sync_editor_from_config()
    refresh_lock()
    refresh_status_line()
    root.report_callback_exception = _log_err
    root.mainloop()


if __name__ == "__main__":
    sys.exit(main())
