#!/usr/bin/env bash
# gifdesk-gui — selector de interfaz (GPL-3.0-or-later).
# GNOME -> gifdesk-gui-gnome (GTK4 + libadwaita, estilo Adwaita).
# Resto  -> gifdesk-gui-kde  (tkinter, estilo Plasma/Breeze).
set -euo pipefail

BIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")" )" && pwd)"
MODE="auto"

for a in "$@"; do
    case "$a" in
        --gnome) MODE="gnome"; shift ;;
        --kde|--tk) MODE="kde"; shift ;;
        -h|--help)
            printf 'Uso: gifdesk-gui [--gnome|--kde]\nSin flags elige segun el escritorio actual.\n'
            exit 0 ;;
        *) break ;;
    esac
done

if [[ "$MODE" == "auto" ]]; then
    de="${XDG_CURRENT_DESKTOP:-} ${DESKTOP_SESSION:-}"
    de="$(printf '%s' "$de" | tr '[:upper:]' '[:lower:]')"
    if [[ "$de" == *gnome* ]]; then
        MODE="gnome"
    else
        MODE="kde"
    fi
fi

if [[ "$MODE" == "gnome" ]]; then
    if [[ -x "$BIN_DIR/gifdesk-gui-gnome" ]]; then
        exec "$BIN_DIR/gifdesk-gui-gnome" "$@"
    fi
    printf 'gifdesk-gui: entorno GNOME pero falta gifdesk-gui-gnome; abro la clasica.\n' >&2
fi

exec "$BIN_DIR/gifdesk-gui-kde" "$@"
