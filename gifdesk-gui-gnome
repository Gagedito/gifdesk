    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gio, GLib, Gtk
    # libadwaita >= 1.2: ToastOverlay, MessageDialog. Sin 1.2 no arrancamos.
