def gui_log(msg):
    try:
        base = Path(os.environ.get("XDG_CACHE_HOME",
                                   os.path.join(str(Path.home()), ".cache")))
        logp = base / "gifdesk" / "gui.log"
        logp.parent.mkdir(parents=True, exist_ok=True)
        with open(logp, "a") as f:
            f.write(str(msg).rstrip() + "\n")
    except Exception:
        pass


def core_version():
    """(mayor, menor) del binario instalado, o None si no se sabe."""
    try:
        p = subprocess.run([BIN, "--version"], capture_output=True,
                           text=True, timeout=10)
        if p.returncode != 0:
            return None
        m = re.search(r"(\d+)\.(\d+)", p.stdout + p.stderr)
        return (int(m.group(1)), int(m.group(2))) if m else None
    except Exception:
        return None


# ---------- lógica de instancias (igual modelo que la GUI KDE) ----------

def blank_cfg():
    return {"FILE": "", "MODE": "widget", "SIZE": "", "POS": "BR",
            "LOCKED": "no", "REV": "0", "OPACITY": "100", "FPS": "0"}


def inst_id(path):
    stem = Path(path).stem.lower().replace(" ", "-")
    clean = "".join(c for c in stem if c.isalnum() or c in ("-", "_"))[:32]
    clean = clean or "gif"
    return "main-gif" if clean == "main" else clean


def inst_conf(iid):
    return INST_DIR / f"{iid}.conf"


def read_config(path):
    cfg = blank_cfg()
    try:
        for line in Path(path).read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            k, v = k.strip(), v.strip().strip('"')
            if k in cfg:
                cfg[k] = v
    except OSError:
        pass
    if cfg["LOCKED"] not in ("yes", "no"):
        cfg["LOCKED"] = "no"
    if not re.match(r"^\d+$", cfg.get("REV", "")):
        cfg["REV"] = "0"
    try:
        op = int(cfg.get("OPACITY", "100"))
    except (TypeError, ValueError):
        op = 100
    cfg["OPACITY"] = str(max(0, min(100, op)))
    try:
        fps = int(cfg.get("FPS", "0") or 0)
    except (TypeError, ValueError):
        fps = 0
    cfg["FPS"] = str(max(0, min(60, fps)))
    if cfg["POS"] not in ("TL", "TR", "BL", "BR", "C") and "," not in cfg["POS"]:
        cfg["POS"] = "BR"
    return cfg


def write_config(cfg, path):
    p = Path(path)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(
        "# gifdesk — configuración (la usa 'gifdesk --autostart')\n"
        f'FILE="{cfg["FILE"]}"\n'
        f'MODE={cfg.get("MODE", "widget")}\n'
        f'SIZE={cfg.get("SIZE", "")}\n'
        f'POS={cfg.get("POS", "BR")}\n'
        f'LOCKED={cfg.get("LOCKED", "no")}\n'
        f'REV={cfg.get("REV", "0")}\n'
        f'OPACITY={cfg.get("OPACITY", "100")}\n'
        f'FPS={cfg.get("FPS", "0")}\n'
    )


def bump_rev(path):
    p = Path(path)
    try:
        lines = p.read_text().splitlines() if p.exists() else []
    except OSError:
        lines = []
    rev = 0
    out = []
    for ln in lines:
        if re.match(r"^\s*REV=", ln):
            try:
                rev = int(re.sub(r"\D", "", ln.split("=", 1)[1]) or 0)
            except ValueError:
                rev = 0
            continue
        out.append(ln)
    out.append(f"REV={rev + 1}")
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text("\n".join(out) + "\n")
    return rev + 1


def resolve_id(path):
    base = inst_id(path)
    me = str(path)
    iid, i = base, 0
    while True:
        conf = inst_conf(iid)
        if not conf.exists():
            return iid
        try:
            got = read_config(conf)["FILE"]
        except OSError:
            return iid
        if got in ("", me):
            return iid
        i += 1
        iid = f"{base}_{i}"


def run_gifdesk(*args):
    try:
        p = subprocess.run([BIN, *args], capture_output=True, text=True, timeout=15)
        return p.returncode, (p.stdout + p.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, str(e)


def run_inst(iid, *args):
    if iid:
        return run_gifdesk("--id", iid, *args)
    return run_gifdesk(*args)


def is_running_inst(iid):
    rc, _ = run_inst(iid, "--status")
    return rc == 0


def running_ids():
    """Ids mostrandose. UNA llamada: el motor GNOME responde con todos y, sin
    motor, `gifdesk --list` ya no relanza el binario por instancia."""
    rc, out = run_gifdesk("--list")
    ids = []
    if rc == 0:
        for line in out.splitlines():
            parts = line.split()
            if len(parts) >= 2 and parts[1] == "corriendo":
                ids.append(parts[0])
    return ids


def live_fps(iid, fps):
    """Cambia la velocidad en vivo via motor (sin recrear el actor).
    True si quedo puesta (asi conserva la posicion donde la arrastraste)."""
    px = engine_proxy()
    if px is None:
        return False
    try:
        ok = px.call_sync("SetFps", GLib.Variant("(si)", (iid, int(fps))),
                          Gio.DBusCallFlags.NONE, 5000, None).unpack()[0]
        return bool(ok)
    except GLib.Error:
        return False


def engine_proxy():
    """Proxy al motor GNOME (org.gifdesk.Widgets). None si no responde."""
    try:
        return Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SESSION, Gio.DBusProxyFlags.NONE, None,
            "org.gifdesk.Widgets", "/org/gifdesk/Widgets",
            "org.gifdesk.Widgets", None)
    except GLib.Error:
        return None


def live_lock(iid, lock):
    """Bloqueo en vivo via motor (sin relanzar). True si quedo puesto."""
    px = engine_proxy()
    if px is None:
        return False
    try:
        ok = px.call_sync("SetLocked", GLib.Variant("(sb)", (iid, bool(lock))),
                          Gio.DBusCallFlags.NONE, 5000, None).unpack()[0]
        if not ok:
            return False
        return True
    except GLib.Error:
        return False


MEDIA_CACHE = {}   # path -> (w, h, frames)
FRAMES_INDEX = None  # sha1_... -> (w, h, n), del cache del motor


def frames_index():
    """WxH y nº de cuadros desde el cache del motor, sin ffprobe.

    `gifdesk` preextrae los PNG a ~/.cache/gifdesk/frames/<sha1_WxH>/. Leyendo
    ese indice, los GIF ya mostrados se describen gratis; ffprobe (~90 ms por
    archivo) queda solo para los que no estan cacheados.
    """
    global FRAMES_INDEX
    if FRAMES_INDEX is not None:
        return FRAMES_INDEX
    FRAMES_INDEX = {}
    rc, out = run_gifdesk("--frames-cache")
    if rc != 0:
        return FRAMES_INDEX
    for line in out.splitlines():
        parts = line.split()
        if len(parts) != 3:
            continue
        path, geo, n = parts
        key = Path(path).name.split("_")[0]
        m = re.match(r"^(\d+)x(\d+)$", geo)
        if key and m and n.isdigit():
            # El indice guarda las variantes por tamano: nos quedamos con la
            # mayor (el motor respeta SIZE de la instancia).
            cur = FRAMES_INDEX.get(key)
            cand = (int(m.group(1)), int(m.group(2)), int(n))
            if cur is None or cand[0] * cand[1] > cur[0] * cur[1]:
                FRAMES_INDEX[key] = cand
    return FRAMES_INDEX


def cached_dims(path):
    """Dimensiones del cache del motor para este archivo, o None."""
    import hashlib
    try:
        h = hashlib.sha1()
        with open(path, "rb") as f:
            for blk in iter(lambda: f.read(1 << 20), b""):
                h.update(blk)
        return frames_index().get(h.hexdigest()[:16])
    except OSError:
        return None


def media_dims(path):
    """(ancho, alto, cuadros|None). Primero el cache del motor (gratis),
    si no ffprobe (cacheado en memoria).

    ffprobe son ~90 ms y se llamaba POR FILA: con 500 GIFs eran 45 s de
    congelamiento en cada arranque.
    """
    if not path:
        return None, None, None
    key = str(path)
    if key in MEDIA_CACHE:
        return MEDIA_CACHE[key]
    hit = cached_dims(path)
    if hit is not None:
        MEDIA_CACHE[key] = hit
        return hit
    try:
        p = subprocess.run(
            ["ffprobe", "-v", "error", "-select_streams", "v:0",
             "-show_entries", "stream=width,height,nb_frames",
             "-of", "csv=p=0", str(path)],
            capture_output=True, text=True, timeout=10)
        parts = p.stdout.strip().split(",")
        if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
            frames = int(parts[2]) if len(parts) > 2 and parts[2].isdigit() else None
            res = (int(parts[0]), int(parts[1]), frames)
            MEDIA_CACHE[key] = res
            return res
    except (OSError, subprocess.SubprocessError):
        pass
    return None, None, None


def file_size(path):
    """Tamano legible. Barato (stat): se usa en cada fila de la galeria."""
    try:
        b = Path(path).stat().st_size
    except OSError:
        return "?"
    return f"{b // 1024} KB" if b < 1024 * 1024 else f"{b / 1048576:.1f} MB"


def file_info(path):
    """Tamano + dimensiones. Con ffprobe: solo para el GIF seleccionado."""
    w, h, frames = media_dims(path)
    if w and h:
        extra = f" · {frames}f" if frames else ""
        return f"{w}×{h}{extra} · {file_size(path)}"
    return file_size(path)


def unique_dest(name):
    dest = LIB_DIR / name
    if not dest.exists():
        return dest
    stem, suf = os.path.splitext(name)
    i = 1
    while True:
        cand = LIB_DIR / f"{stem}_{i}{suf}"
        if not cand.exists():
            return cand
        i += 1


def adopt_legacy(p_str, full=False):
    legacy = read_config(LEGACY_FILE)
    if not legacy["FILE"]:
        return
    if full or legacy["FILE"] == p_str:
        if run_gifdesk("--status")[0] == 0:
            run_gifdesk("--stop")
        legacy["FILE"] = ""
        write_config(legacy, LEGACY_FILE)


def apply_live_geometry(iid, cfg):
    """Lee X Y W H reales del motor y los guarda en la config + bump.
    Devuelve (x, y, w, h) o None si no se ve."""
    px = engine_proxy()
    if px is None:
        return None
    try:
        res = px.call_sync("Geometry", GLib.Variant("(s)", (iid,)),
                           Gio.DBusCallFlags.NONE, 5000, None).unpack()[0]
    except GLib.Error:
        return None
    if not res or res == "NONE":
        return None
    parts = res.split()
    if len(parts) != 5:
        return None
    _iid, x, y, w, h = parts
    if not (x.lstrip("-").isdigit() and y.lstrip("-").isdigit()
            and w.isdigit() and h.isdigit()):
        return None
    x, y = max(0, int(x)), max(0, int(y))
    w, h = max(48, int(w)), max(48, int(h))
    cfg["POS"] = f"{x},{y}"
    cfg["SIZE"] = f"{w}x{h}"
    write_config(cfg, inst_conf(iid))
    bump_rev(inst_conf(iid))
    return x, y, w, h


def ext_state():
    """Estado del motor GNOME: enabled (responde) | missing (apagado)."""
    px = engine_proxy()
    if px is None:
        return "missing"
    try:
        px.call_sync("List", None, Gio.DBusCallFlags.NONE, 5000, None)
        return "enabled"
    except GLib.Error:
        return "missing"


def _probe_all(paths):
    """Completa en un hilo lo que el indice del motor no cubre (los GIFs
    nunca mostrados). Solo se paga una vez: queda en MEDIA_CACHE."""
    for p in paths:
        if str(p) not in MEDIA_CACHE and cached_dims(p) is None:
            media_dims(p)
    return (0, "")


# ---------- confirmacion (AlertDialog >=1.5; MessageDialog en 1.2-1.4) ----------

def ask(parent_app, parent, heading, body, ok_label="_Borrar", on_ok=None):
    """Si/no con Adw. on_ok() solo si el usuario confirma.

    Adw.MessageDialog tiene `add_response` (singular): llamar `add_responses`
    lanza AttributeError y el boton no hacia NADA (fallo silencioso, porque
    el .desktop se come stderr). Preferimos AlertDialog (>=1.5) y solo caemos
    en MessageDialog en libadwaita antiguo.
    """
    if hasattr(Adw, "AlertDialog"):
        dlg = Adw.AlertDialog.new(heading, body)
        dlg.add_response("cancel", "_Cancelar")
        dlg.add_response("ok", ok_label)
        dlg.set_response_appearance("ok", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_default_response("cancel")
        dlg.set_close_response("cancel")

        def on_resp(d, resp):
            if resp == "ok" and on_ok:
                on_ok()

        dlg.connect("response", on_resp)
        Adw.Dialog.present(dlg, parent)
        return dlg

    dlg = Adw.MessageDialog.new(parent, heading, body)
    dlg.add_response("cancel", "_Cancelar")
    dlg.add_response("ok", ok_label)
    dlg.set_response_appearance("ok", Adw.ResponseAppearance.DESTRUCTIVE)
    dlg.set_default_response("cancel")
    dlg.set_close_response("cancel")
    dlg.connect("response",
                lambda d, resp: on_ok() if resp == "ok" and on_ok else None)
    dlg.present()
    return dlg


# ---------- widgets (solo GTK4 nucleo + Adw 1.0-1.2) ----------

def spin_row(title, subtitle, lo, hi, step=1):
    """Fila con etiqueta + Gtk.SpinButton. Devuelve (ListBoxRow, SpinButton)."""
    row = Gtk.ListBoxRow(selectable=False, activatable=False)
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
    box.set_margin_top(8)
    box.set_margin_bottom(8)
    box.set_margin_start(12)
    box.set_margin_end(12)
    lab = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    lab.set_hexpand(True)
    t = Gtk.Label(label=title, halign=Gtk.Align.START)
    lab.append(t)
    if subtitle:
        s = Gtk.Label(label=subtitle, halign=Gtk.Align.START)
        s.add_css_class("caption")
        s.add_css_class("dim-label")
        lab.append(s)
    spin = Gtk.SpinButton(valign=Gtk.Align.CENTER)
    spin.set_adjustment(Gtk.Adjustment(value=0, lower=lo, upper=hi,
                                       step_increment=step,
                                       page_increment=step * 10,
                                       page_size=0))
    spin.set_digits(0)
    box.append(lab)
    box.append(spin)
    row.set_child(box)
    return row, spin


def action_button_row(title, subtitle, label, css=None):
    """Adw.ActionRow con botón al final. Devuelve (row, button)."""
    row = Adw.ActionRow(title=title)
    if subtitle:
        row.set_subtitle(subtitle)
    btn = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
    if css:
        btn.add_css_class(css)
    row.add_suffix(btn)
    return row, btn


# ---------- aplicación ----------

class GestorApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="local.gifdesk.Gestor",
                         flags=Gio.ApplicationFlags.FLAGS_NONE)
        LIB_DIR.mkdir(parents=True, exist_ok=True)
        INST_DIR.mkdir(parents=True, exist_ok=True)
        self.cfg = blank_cfg()
        self.cur_id = None
        self._syncing = False
        self.win = None
        # Ids en pantalla segun el motor (una sola llamada). Se usa para pintar
        # las marcas sin lanzar un subproceso por fila.
        self._shown_ids = set()
        # Filtro de la galeria (texto busqueda). Vacio = todas.
        self.filter_text = ""

    def do_activate(self):
        # Lanzar desde el menu con la app ya abierta: solo se enfoca la
        # ventana existente. Antes se creaba otra y se reconstruia la galeria
        # entera (lento con muchos GIFs).
        if self.win is not None:
            self.win.present()
            return
        win = Adw.ApplicationWindow(application=self)
        win.set_title("gifdesk — gestor (GNOME)")
        win.set_default_size(980, 680)
        # Guardar la ventana: reutilizarla evita que cada launch del menu
        # construya otra (con la galeria entera) encima.
        self.win = win

        toast_overlay = Adw.ToastOverlay()
        win.set_content(toast_overlay)
        self.toast_overlay = toast_overlay

        main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        toast_overlay.set_child(main)

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title="gifdesk",
                                                subtitle="gestor · edición GNOME"))
        main.append(header)

        self.info_label = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER)
        self.info_label.add_css_class("caption")
        self.info_label.add_css_class("dim-label")
        self.info_label.set_margin_top(4)
        self.info_label.set_margin_bottom(4)
        self.info_label.set_margin_start(12)
        self.info_label.set_margin_end(12)
        main.append(self.info_label)
        main.append(Gtk.Separator())

        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        paned.set_vexpand(True)
        paned.set_position(320)
        paned.set_shrink_start_child(False)
        main.append(paned)

        # --- lateral: galería ---
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        side.set_size_request(280, -1)
        paned.set_start_child(side)
        side_title = Gtk.Label(label="Galería (librería)", halign=Gtk.Align.START)
        side_title.add_css_class("heading")
        side_title.set_margin_top(8)
        side_title.set_margin_start(12)
        side.append(side_title)

        # Filtro: con 500 GIFs hay que poder llegar al que se busca.
        self.search = Gtk.SearchEntry(hexpand=True)
        self.search.set_placeholder_text("Filtrar GIFs…")
        self.search.set_margin_start(6)
        self.search.set_margin_end(6)
        self.search.set_margin_bottom(6)
        self.search.connect("search-changed", self._on_search)
        side.append(self.search)

        side_box = Gtk.ScrolledWindow(vexpand=True)
        side_box.set_margin_top(6)
        side_box.set_margin_start(6)
        side_box.set_margin_end(6)
        side.append(side_box)
        self.gallery = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.gallery.add_css_class("boxed-list")
        side_box.set_child(self.gallery)
        self.gallery.connect("row-selected", self._on_row_selected)
        # Supr borra la fila seleccionada (sin apuntar al boton). El filtro
        # se queda: al borrar pruebas sigues viendo el resto de la lista.
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._on_gallery_key)
        self.gallery.add_controller(keys)

        side_btns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        side_btns.set_margin_top(6)
        side_btns.set_margin_bottom(6)
        side_btns.set_margin_start(6)
        side_btns.set_margin_end(6)
        side.append(side_btns)
        # Los handlers se conectan uno a uno: comparar metodos enlazados con
        # `is`/`in` es falso (cada acceso crea un objeto nuevo) y dejaba los
        # botones sin conexion -> no hacian nada.
        add_btn = Gtk.Button(label="Añadir", hexpand=True)
        add_btn.connect("clicked", lambda _b: self.do_add(win))
        del_btn = Gtk.Button(label="Borrar", hexpand=True)
        del_btn.connect("clicked", lambda _b: self.do_delete(win))
        show_btn = Gtk.Button(label="Mostrar", hexpand=True)
        show_btn.add_css_class("suggested-action")
        show_btn.connect("clicked", lambda _b: self.do_show())
        for b in (add_btn, del_btn, show_btn):
            side_btns.append(b)

        # Borrado masivo: borra lo que deje el filtro (limpiar los de test).
        self.bulk_btn = Gtk.Button(label="Borrar filtrados")
        self.bulk_btn.set_margin_start(6)
        self.bulk_btn.set_margin_end(6)
        self.bulk_btn.set_margin_bottom(6)
        self.bulk_btn.set_tooltip_text(
            "Borra de la galería todos los GIF que muestra el filtro")
        self.bulk_btn.connect("clicked", lambda _b: self.do_delete_many(win))
        side.append(self.bulk_btn)

        # --- contenido: editor ---
        content_scroll = Gtk.ScrolledWindow(vexpand=True)
        paned.set_end_child(content_scroll)
        page = Adw.PreferencesPage()
        content_scroll.set_child(page)

        g_file = Adw.PreferencesGroup(title="GIF seleccionado")
