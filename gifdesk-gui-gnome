INST_DIR = CONFIG_DIR / "instances"
LIB_DIR = HOME / ".local" / "share" / "gifdesk" / "library"
BIN = shutil.which("gifdesk") or str(HOME / ".local" / "bin" / "gifdesk")
EXT_UUID = "gifdesk-widgets@gifdesk.local"

SUPPORTED = (".gif", ".webp")
PRESETS = ["BR", "BL", "TR", "TL", "C", "Personalizada…"]

MIN_CORE = (2, 0)


def gui_log(msg):
    try:
        base = Path(os.environ.get("XDG_CACHE_HOME",
                                   os.path.join(str(Path.home()), ".cache")))
        logp = base / "gifdesk" / "gui.log"
        logp.parent.mkdir(parents=True, exist_ok=True)
        with open(logp, "a") as f:
            f.write(str(msg).rstrip() + "\n")
    except Exception:
        pass


def core_version():
    """(mayor, menor) del binario instalado, o None si no se sabe."""
    try:
        p = subprocess.run([BIN, "--version"], capture_output=True,
                           text=True, timeout=10)
        if p.returncode != 0:
            return None
        m = re.search(r"(\d+)\.(\d+)", p.stdout + p.stderr)
        return (int(m.group(1)), int(m.group(2))) if m else None
    except Exception:
        return None


# ---------- lógica de instancias (igual modelo que la GUI KDE) ----------

def blank_cfg():
    return {"FILE": "", "MODE": "widget", "SIZE": "", "POS": "BR",
            "LOCKED": "no", "REV": "0", "OPACITY": "100"}


def inst_id(path):
    stem = Path(path).stem.lower().replace(" ", "-")
    clean = "".join(c for c in stem if c.isalnum() or c in ("-", "_"))[:32]
    clean = clean or "gif"
    return "main-gif" if clean == "main" else clean


def inst_conf(iid):
    return INST_DIR / f"{iid}.conf"


def read_config(path):
    cfg = blank_cfg()
    try:
        for line in Path(path).read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            k, v = k.strip(), v.strip().strip('"')
            if k in cfg:
                cfg[k] = v
    except OSError:
        pass
    if cfg["LOCKED"] not in ("yes", "no"):
        cfg["LOCKED"] = "no"
    if not re.match(r"^\d+$", cfg.get("REV", "")):
        cfg["REV"] = "0"
    try:
        op = int(cfg.get("OPACITY", "100"))
    except (TypeError, ValueError):
        op = 100
    cfg["OPACITY"] = str(max(0, min(100, op)))
    if cfg["POS"] not in ("TL", "TR", "BL", "BR", "C") and "," not in cfg["POS"]:
        cfg["POS"] = "BR"
    return cfg


def write_config(cfg, path):
    p = Path(path)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(
        "# gifdesk — configuración (la usa 'gifdesk --autostart')\n"
        f'FILE="{cfg["FILE"]}"\n'
        f'MODE={cfg.get("MODE", "widget")}\n'
        f'SIZE={cfg.get("SIZE", "")}\n'
        f'POS={cfg.get("POS", "BR")}\n'
        f'LOCKED={cfg.get("LOCKED", "no")}\n'
        f'REV={cfg.get("REV", "0")}\n'
        f'OPACITY={cfg.get("OPACITY", "100")}\n'
    )


def bump_rev(path):
    p = Path(path)
    try:
        lines = p.read_text().splitlines() if p.exists() else []
    except OSError:
        lines = []
    rev = 0
    out = []
    for ln in lines:
        if re.match(r"^\s*REV=", ln):
            try:
                rev = int(re.sub(r"\D", "", ln.split("=", 1)[1]) or 0)
            except ValueError:
                rev = 0
            continue
        out.append(ln)
    out.append(f"REV={rev + 1}")
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text("\n".join(out) + "\n")
    return rev + 1


def resolve_id(path):
    base = inst_id(path)
    me = str(path)
    iid, i = base, 0
    while True:
        conf = inst_conf(iid)
        if not conf.exists():
            return iid
        try:
            got = read_config(conf)["FILE"]
        except OSError:
            return iid
        if got in ("", me):
            return iid
        i += 1
        iid = f"{base}_{i}"


def run_gifdesk(*args):
    try:
        p = subprocess.run([BIN, *args], capture_output=True, text=True, timeout=15)
        return p.returncode, (p.stdout + p.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, str(e)


def run_inst(iid, *args):
    if iid:
        return run_gifdesk("--id", iid, *args)
    return run_gifdesk(*args)


def is_running_inst(iid):
    rc, _ = run_inst(iid, "--status")
    return rc == 0


def running_ids():
    rc, out = run_gifdesk("--list")
    ids = []
    if rc == 0:
        for line in out.splitlines():
            parts = line.split()
            if len(parts) >= 2 and parts[1] == "corriendo":
                ids.append(parts[0])
    return ids


def engine_proxy():
    """Proxy al motor GNOME (org.gifdesk.Widgets). None si no responde."""
    try:
        return Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SESSION, Gio.DBusProxyFlags.NONE, None,
            "org.gifdesk.Widgets", "/org/gifdesk/Widgets",
            "org.gifdesk.Widgets", None)
    except GLib.Error:
        return None


def live_lock(iid, lock):
    """Bloqueo en vivo via motor (sin relanzar). True si quedo puesto."""
    px = engine_proxy()
    if px is None:
        return False
    try:
        ok = px.call_sync("SetLocked", GLib.Variant("(sb)", (iid, bool(lock))),
                          Gio.DBusCallFlags.NONE, 5000, None).unpack()[0]
        if not ok:
            return False
        return True
    except GLib.Error:
        return False


def media_dims(path):
    try:
        p = subprocess.run(
            ["ffprobe", "-v", "error", "-select_streams", "v:0",
             "-show_entries", "stream=width,height,nb_frames",
             "-of", "csv=p=0", str(path)],
            capture_output=True, text=True, timeout=10)
        parts = p.stdout.strip().split(",")
        if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
            frames = int(parts[2]) if len(parts) > 2 and parts[2].isdigit() else None
            return int(parts[0]), int(parts[1]), frames
    except (OSError, subprocess.SubprocessError):
        pass
    return None, None, None


def file_info(path):
    w, h, frames = media_dims(path)
    if w and h:
        extra = f" · {frames}f" if frames else ""
        return f"{w}×{h}{extra}"
    try:
        kb = Path(path).stat().st_size // 1024
        return f"{kb} KB"
    except OSError:
        return "?"


def unique_dest(name):
    dest = LIB_DIR / name
    if not dest.exists():
        return dest
    stem, suf = os.path.splitext(name)
    i = 1
    while True:
        cand = LIB_DIR / f"{stem}_{i}{suf}"
        if not cand.exists():
            return cand
        i += 1


def adopt_legacy(p_str, full=False):
    legacy = read_config(LEGACY_FILE)
    if not legacy["FILE"]:
        return
    if full or legacy["FILE"] == p_str:
        if run_gifdesk("--status")[0] == 0:
            run_gifdesk("--stop")
        legacy["FILE"] = ""
        write_config(legacy, LEGACY_FILE)


def apply_live_geometry(iid, cfg):
    """Lee X Y W H reales del motor y los guarda en la config + bump.
    Devuelve (x, y, w, h) o None si no se ve."""
    px = engine_proxy()
    if px is None:
        return None
    try:
        res = px.call_sync("Geometry", GLib.Variant("(s)", (iid,)),
                           Gio.DBusCallFlags.NONE, 5000, None).unpack()[0]
    except GLib.Error:
        return None
    if not res or res == "NONE":
        return None
    parts = res.split()
    if len(parts) != 5:
        return None
    _iid, x, y, w, h = parts
    if not (x.lstrip("-").isdigit() and y.lstrip("-").isdigit()
            and w.isdigit() and h.isdigit()):
        return None
    x, y = max(0, int(x)), max(0, int(y))
    w, h = max(48, int(w)), max(48, int(h))
    cfg["POS"] = f"{x},{y}"
    cfg["SIZE"] = f"{w}x{h}"
    write_config(cfg, inst_conf(iid))
    bump_rev(inst_conf(iid))
    return x, y, w, h


def ext_state():
    """Estado del motor GNOME: enabled (responde) | missing (apagado)."""
    px = engine_proxy()
    if px is None:
        return "missing"
    try:
        px.call_sync("List", None, Gio.DBusCallFlags.NONE, 5000, None)
        return "enabled"
    except GLib.Error:
        return "missing"


# ---------- widgets (solo GTK4 núcleo + Adw 1.0–1.2) ----------

def spin_row(title, subtitle, lo, hi, step=1):
    """Fila con etiqueta + Gtk.SpinButton. Devuelve (ListBoxRow, SpinButton)."""
    row = Gtk.ListBoxRow(selectable=False, activatable=False)
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
    box.set_margin_top(8)
    box.set_margin_bottom(8)
    box.set_margin_start(12)
    box.set_margin_end(12)
    lab = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    lab.set_hexpand(True)
    t = Gtk.Label(label=title, halign=Gtk.Align.START)
    lab.append(t)
    if subtitle:
        s = Gtk.Label(label=subtitle, halign=Gtk.Align.START)
        s.add_css_class("caption")
        s.add_css_class("dim-label")
        lab.append(s)
    spin = Gtk.SpinButton(valign=Gtk.Align.CENTER)
    spin.set_adjustment(Gtk.Adjustment(value=0, lower=lo, upper=hi,
                                       step_increment=step,
                                       page_increment=step * 10,
                                       page_size=0))
    spin.set_digits(0)
    box.append(lab)
    box.append(spin)
    row.set_child(box)
    return row, spin


def action_button_row(title, subtitle, label, css=None):
    """Adw.ActionRow con botón al final. Devuelve (row, button)."""
    row = Adw.ActionRow(title=title)
    if subtitle:
        row.set_subtitle(subtitle)
    btn = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
    if css:
        btn.add_css_class(css)
    row.add_suffix(btn)
    return row, btn


