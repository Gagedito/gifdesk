    # ---------- utilidades UI ----------

    def toast(self, msg):
        self.toast_overlay.add_toast(Adw.Toast.new(msg))

    def in_thread(self, fn, done):
        def run():
            try:
                res = fn()
            except Exception as e:  # noqa: BLE001
                res = (1, str(e))

            def idle():
                done(res)
                return False
            GLib.idle_add(idle)
        threading.Thread(target=run, daemon=True).start()

    def check_core_version(self):
        v = core_version()
        if v is None or v < MIN_CORE:
            shown = f"{v[0]}.{v[1]}" if v else "desconocida"
            self.toast(f"Nucleo gifdesk {shown} viejo: reinstala para funciones en vivo")
            gui_log(f"nucleo viejo o ilegible ({shown}); se necesita >= "
                    f"{MIN_CORE[0]}.{MIN_CORE[1]} para motor/IPC en vivo")
    def row_info(self, p, index):
        """Subtitulo de una fila: dimensiones si ya las sabemos (cache del
        motor), si no solo el tamano. Nunca bloquea con ffprobe."""
        try:
            import hashlib
            h = hashlib.sha1()
            with open(p, "rb") as f:
                for blk in iter(lambda: f.read(1 << 20), b""):
                    h.update(blk)
            hit = index.get(h.hexdigest()[:16])
        except OSError:
            hit = None
        if hit:
            w, h, n = hit
            return f"{w}×{h} · {n}f"
        return file_size(p)

    def _fill_dims(self):
        """Enriquece las filas con WxH (ffprobe) en 2o plano, sin congelar.

        Antes esto pasaba al pintar cada fila: era el arranque lento. Ahora la
        lista es util al instante y las dimensiones llegan al terminar.
        """
        files = self.library_files()
        self.in_thread(lambda: _probe_all(files), self._dims_ready)
        return False

    def _dims_ready(self, res):
        rc, _ = res
        if rc != 0:
            return
        p = self.selected_path()
        if p is not None:
            self.row_current.set_subtitle(file_info(p))
        self.refresh_list(select_name=p.name if p else None)

    def refresh_banner(self):
        st = ext_state()
        if st == "enabled":
            self.info_label.set_text("Motor GNOME activo: actores sin ventana (sin dock ni alt-tab), siempre encima, opacidad real.")
        else:
            self.info_label.set_text("Motor GNOME apagado: instala/activa la extensión gifdesk (install.sh --with-gnome o el flake) y re-loguea.")

    def library_files(self):
        """GIFs de la libreria, ya filtrados por el texto de busqueda."""
        files = sorted(
            (p for p in LIB_DIR.iterdir()
             if p.is_file() and p.suffix.lower() in SUPPORTED),
            key=lambda p: p.name.lower())
        needle = self.filter_text.strip().lower()
        if needle:
            files = [p for p in files if needle in p.name.lower()]
        return files

    def selected_path(self):
        row = self.gallery.get_selected_row()
        return getattr(row, "_path", None) if row is not None else None

    def _on_search(self, entry):
        self.filter_text = entry.get_text()
        self.refresh_list()

    def _on_gallery_key(self, _ctrl, keyval, _code, _state):
        """Supr/Retroceso borra la fila enfocada (si hay seleccion)."""
        if keyval not in (Gdk.KEY_Delete, Gdk.KEY_BackSpace):
            return False
        if self.selected_path() is None:
            return False
        self.do_delete(self.props.active_window)
        return True

    # ---------- galería ----------

    def refresh_list(self, select_name=None):
        if select_name is None:
            p0 = self.selected_path()
            select_name = p0.name if p0 else None
        while True:
            child = self.gallery.get_first_child()
            if child is None:
                break
            self.gallery.remove(child)
        files = self.library_files()
        # Una sola consulta al motor para todas las marcas: antes era un
        # subproceso por fila (con 500 GIFs, 500 procesos en cada refresco).
        self._shown_ids = set(running_ids())
        # Indice de dimensiones en una llamada (gratis si esta cacheado).
        index = frames_index()
        sel_row = None
        for p in files:
            mark = " · en pantalla" if resolve_id(p) in self._shown_ids else ""
            row = Adw.ActionRow(title=p.name)
            row.set_subtitle(f"{self.row_info(p, index)}{mark}")
            row._path = p
            self.gallery.append(row)
            if select_name is not None and p.name == select_name:
                sel_row = row
        if sel_row is not None:
            self.gallery.select_row(sel_row)
        elif self.gallery.get_first_child() is not None and self.gallery.get_selected_row() is None:
            self.gallery.select_row(self.gallery.get_row_at_index(0))
        self.load_selection()

    def _on_row_selected(self, _box, _row):
        self.load_selection()

    def load_selection(self):
        p = self.selected_path()
        if p is None:
            self.cur_id = None
            self.cfg = blank_cfg()
        else:
            self.cur_id = resolve_id(p)
            self.cfg = read_config(inst_conf(self.cur_id))
            if not self.cfg["FILE"]:
                self.cfg["FILE"] = str(p)
        self.sync_editor()
        self.refresh_lock()
        self.refresh_current()
        self.refresh_status()

    def refresh_current(self):
        f = self.cfg["FILE"]
        base = Path(f).name if f else "(ninguno)"
        if self.cur_id:
            self.row_current.set_title(f"{base}  [instancia: {self.cur_id}]")
        else:
            self.row_current.set_title(base)

    def refresh_status(self):
        if self.cur_id and is_running_inst(self.cur_id):
            self.row_status.set_title(f"Estado: {self.cur_id} mostrando en pantalla")
        elif self.cur_id:
            self.row_status.set_title(f"Estado: {self.cur_id} detenido")
        else:
            self.row_status.set_title("Estado: sin selección")

    def refresh_lock(self):
        locked = self.cfg.get("LOCKED", "no") == "yes"
        self.row_lock.set_title("Posición: BLOQUEADA (ignora el ratón)" if locked
                                else "Posición: libre (se puede mover)")
        self.btn_lock.set_label("Desbloquear posición" if locked else "Bloquear posición")

    # ---------- editor ----------

    def sync_editor(self):
        self._syncing = True
        try:
            size = self.cfg.get("SIZE", "")
            w = h = 0
            if size and "x" in size.lower():
                try:
                    w, h = (int(x.strip()) for x in size.lower().split("x", 1))
                except ValueError:
                    w = h = 0
            self.spin_w.set_value(w)
            self.spin_h.set_value(h)
            try:
                dims = media_dims(self.cfg["FILE"]) if self.cfg.get("FILE") else (None, None, None)
                w0, h0 = dims[0], dims[1]
                if w and h and w0 and h0:
                    self.spin_pct.set_value(max(25, min(200, round(w * 100 / w0))))
                else:
                    self.spin_pct.set_value(100)
            except (ValueError, ZeroDivisionError):
                self.spin_pct.set_value(100)
            try:
                self.spin_opa.set_value(int(self.cfg.get("OPACITY", "100")))
            except (TypeError, ValueError):
                self.spin_opa.set_value(100)
            try:
                self.spin_fps.set_value(
                    max(0, min(60, int(self.cfg.get("FPS", "0") or 0))))
            except (TypeError, ValueError):
                self.spin_fps.set_value(0)
            pos = self.cfg.get("POS", "BR")
            if pos in PRESETS[:5]:
                self.dropdown.set_selected(PRESETS.index(pos))
                self.row_x.set_visible(False)
                self.row_y.set_visible(False)
            else:
                self.dropdown.set_selected(5)
                self.row_x.set_visible(True)
                self.row_y.set_visible(True)
                if "," in pos:
                    try:
                        x, y = (int(v.strip()) for v in pos.split(",", 1))
                        self.spin_x.set_value(max(0, x))
                        self.spin_y.set_value(max(0, y))
                    except ValueError:
                        pass
            f = self.cfg.get("FILE", "")
            if f and Path(f).exists():
                try:
                    self.preview.set_filename(f)
                    self.row_current.set_subtitle(file_info(Path(f)))
                except (GLib.Error, TypeError):
                    self.preview.set_paintable(None)
            else:
                self.preview.set_paintable(None)
        finally:
            self._syncing = False

    def _on_pct(self, _spin):
        if self._syncing or not self.cfg.get("FILE"):
            return
        w0, h0, _ = media_dims(self.cfg["FILE"])
        if w0 and h0:
            pc = int(self.spin_pct.get_value())
            self.spin_w.set_value(max(48, round(w0 * pc / 100)))
            self.spin_h.set_value(max(48, round(h0 * pc / 100)))

    def _on_preset(self, _dropdown, _pspec):
        custom = self.dropdown.get_selected() == 5
        self.row_x.set_visible(custom)
        self.row_y.set_visible(custom)

    def collect_editor(self):
        self.cfg["FPS"] = str(int(self.spin_fps.get_value()))
        w, h = int(self.spin_w.get_value()), int(self.spin_h.get_value())
        if w or h:
            if w <= 0 or h <= 0:
                return None, "Ancho/alto: pon ambos o ambos a 0 (= nativo)"
            self.cfg["SIZE"] = f"{w}x{h}"
        else:
            self.cfg["SIZE"] = ""
        if self.dropdown.get_selected() == 5:
            self.cfg["POS"] = f"{int(self.spin_x.get_value())},{int(self.spin_y.get_value())}"
        else:
            self.cfg["POS"] = PRESETS[self.dropdown.get_selected()]
        self.cfg["OPACITY"] = str(int(self.spin_opa.get_value()))
        return True, ""

    # ---------- acciones ----------

    def do_add(self, win):
        dlg = Gtk.FileChooserNative(title="Añadir GIF / WebP",
                                    transient_for=win,
                                    action=Gtk.FileChooserAction.OPEN,
                                    accept_label="_Añadir",
                                    cancel_label="_Cancelar")
        flt = Gtk.FileFilter()
        flt.set_name("GIF/WebP")
        flt.add_pattern("*.gif")
        flt.add_pattern("*.webp")
        flt.add_pattern("*.GIF")
        flt.add_pattern("*.WEBP")
        dlg.set_filter(flt)

        def on_response(native, resp):
            if resp == Gtk.ResponseType.ACCEPT:
                f = native.get_file()
                src = f.get_path() if f else None
                if src and Path(src).suffix.lower() in SUPPORTED:
                    dest = unique_dest(Path(src).name)
                    try:
                        shutil.copy2(src, dest)
                        self.refresh_list(select_name=dest.name)
                        self.toast(f"Añadido: {dest.name}")
                    except OSError as e:
                        self.toast(f"No se pudo copiar: {e}")
                else:
                    self.toast("Solo .gif / .webp")
            native.destroy()

        dlg.connect("response", on_response)
        dlg.show()

    def delete_path(self, p):
        """Borra archivo + instancia de un GIF. True si el archivo fue."""
        MEDIA_CACHE.pop(str(p), None)
        iid = resolve_id(p)
        run_inst(iid, "--stop")
        try:
            inst_conf(iid).unlink(missing_ok=True)
        except OSError:
            pass
        try:
            p.unlink()
        except OSError as e:
            self.toast(f"No se pudo borrar {p.name}: {e}")
            return False
        return True

    def do_delete(self, win):
        """Borrar el GIF seleccionado (el boton o la tecla Supr)."""
        p = self.selected_path()
        if p is None:
            return
        ask(self, win, "Borrar de la galería?",
            f"{p.name}\nSe elimina el archivo y su instancia.",
            ok_label="_Borrar", on_ok=lambda: self._delete_done([p]))

    def do_delete_many(self, win):
        """Borrar todo lo que deja el filtro (limpiar los GIFs de test)."""
        victims = self.library_files()
        if not victims:
            self.toast("No hay GIFs que borrar con ese filtro")
            return
        shown = [p.name for p in victims[:4]]
        extra = f"\n… y {len(victims) - 4} más" if len(victims) > 4 else ""
        ask(self, win, f"Borrar {len(victims)} GIFs?",
            "\n".join(shown) + extra + "\n\nSe borran archivo e instancia.",
            ok_label=f"_Borrar {len(victims)}",
            on_ok=lambda: self._delete_done(victims))

    def _delete_done(self, victims):
        gone = [p for p in victims if self.delete_path(p)]
        self.refresh_list()
        if len(gone) == 1:
            self.toast(f"Borrado: {gone[0].name}")
        elif gone:
            self.toast(f"Borrados {len(gone)} GIFs")
        else:
            self.toast("No se pudo borrar nada")

    def do_show(self):
        p = self.selected_path()
        if p is None:
            return
        iid = resolve_id(p)
        self.cur_id = iid
        self.cfg["FILE"] = str(p)
        write_config(self.cfg, inst_conf(iid))
        bump_rev(inst_conf(iid))
        adopt_legacy(str(p), full=True)
        self.refresh_current()
        self.refresh_list(select_name=p.name)
        self.toast("Mostrando…")

        def done(res):
            rc, out = res
            if rc != 0:
                self.toast(f"No se pudo mostrar: {out[:200]}")
            self.refresh_list(select_name=p.name)

        self.in_thread(lambda: run_inst(iid, "--autostart"), done)

    def do_native(self):
        if self.cfg.get("FILE"):
            w0, h0, _ = media_dims(self.cfg["FILE"])
            if w0 and h0:
                self.spin_w.set_value(w0)
                self.spin_h.set_value(h0)
        else:
            self.spin_w.set_value(0)
            self.spin_h.set_value(0)
        self.spin_pct.set_value(100)
        self.do_apply()

    def do_apply(self):
        ok, err = self.collect_editor()
        if not ok:
            self.toast(err)
            return
        iid = self.cur_id
        if iid is None:
            self.toast("Selecciona un GIF de la galería")
            return
        adopt_legacy(self.cfg.get("FILE", ""))
        disk = read_config(inst_conf(iid))
        changed = {k for k in ("SIZE", "MODE", "POS", "OPACITY", "FPS")
                   if self.cfg.get(k, "") != disk.get(k, "")}
        write_config(self.cfg, inst_conf(iid))
        if changed:
            bump_rev(inst_conf(iid))
        if not self.cfg["FILE"]:
            self.toast("Sin archivo actual: elige uno y pulsa Mostrar")
            return
        if not changed and is_running_inst(iid):
            self.refresh_status()
            self.toast(f"Sin cambios (sigue igual @ {self.cfg['POS'] or 'nativo'})")
            return
        # Solo fps: se cambia en vivo (el actor no se recrea, no se mueve).
        if changed == {"FPS"} and is_running_inst(iid):
            self.do_fps(int(self.cfg["FPS"]))
            return
        self.toast("Aplicando…")
        self.btn_apply.set_sensitive(False)

        def done(res):
            rc, out = res
            if rc != 0:
                self.toast(f"No se pudo aplicar: {out[:200]}")
            else:
                self.toast(f"Aplicado: {self.cfg['SIZE'] or 'nativo'} @ {self.cfg['POS']}")
            self.sync_editor()
            self.refresh_status()
            self.btn_apply.set_sensitive(True)

        self.in_thread(lambda: run_inst(iid, "--autostart"), done)

    def do_fps(self, fps):
        """Velocidad de ESA imagen. En vivo si el motor responde; si no,
        relanza (como cualquier otro cambio)."""
        iid = self.cur_id
        if iid is None:
            self.toast("Selecciona un GIF de la galería")
            return
        fps = max(0, min(60, int(fps)))
        self.cfg["FPS"] = str(fps)
        self.spin_fps.set_value(fps)
        write_config(self.cfg, inst_conf(iid))
        if fps > 0:
            bump_rev(inst_conf(iid))
        if not is_running_inst(iid):
            self.toast("Guardado (se aplicará al mostrarlo)")
            return

        def work():
            # En vivo primero: conserva la posicion donde la arrastraste.
            if live_fps(iid, fps):
                return ("live", None)
            run_inst(iid, "--autostart")
            return ("relaunch", None)

        def done(res):
            kind, _ = res
            self.toast(f"Velocidad: {fps} fps" if fps else "Velocidad: original")
            self.sync_editor()
            self.refresh_status()
            self.refresh_list(select_name=Path(self.cfg["FILE"]).name
                              if self.cfg.get("FILE") else None)
            if kind == "relaunch":
                self.toast("Motor sin respuesta en vivo: relanzado")

        self.in_thread(work, done)

    def do_lock_toggle(self):
        iid = self.cur_id
        if iid is None:
            self.toast("Selecciona un GIF de la galería")
            return
        if not is_running_inst(iid):
            others = [i for i in running_ids() if i != iid]
            if others:
                self.toast(f"'{iid}' no se muestra. En pantalla: {', '.join(others)}")
            else:
                self.toast("Ningún GIF se está mostrando")
            self.refresh_status()
            return
        new_lock = "no" if self.cfg.get("LOCKED") == "yes" else "yes"
        lock = new_lock == "yes"
        self.toast(f"{'Bloqueando' if lock else 'Desbloqueando'} {iid}…")

        def work():
            live = apply_live_geometry(iid, self.cfg)
            self.cfg["LOCKED"] = new_lock
            adopt_legacy(self.cfg.get("FILE", ""))
            write_config(self.cfg, inst_conf(iid))
            if live is None:
                bump_rev(inst_conf(iid))
            if live_lock(iid, lock):
                return ("live", None)
            return ("relaunch", None)

        def done(res):
            kind, _out = res
            if kind == "live":
                verb = "Bloqueado" if lock else "Desbloqueado"
                self.toast(f"{verb} {iid} donde está (en vivo)")
                self.refresh_lock()
                self.refresh_status()
                self.sync_editor()
            else:
                gui_log(f"bloqueo {iid}: sin motor en vivo, relanzo (nucleo/extension viejos?)")
                self.toast("Sin motor en vivo: relanzo (reinstala ./install.sh si se repite)")

                def done2(res2):
                    rc, out = res2
                    if rc != 0:
                        self.toast(f"No se pudo aplicar: {out[:200]}")
                    else:
                        verb = "Bloqueado" if lock else "Desbloqueado"
                        self.toast(f"{verb} {iid} en su sitio ({self.cfg['POS'] or 'BR'})")
                    self.refresh_lock()
                    self.refresh_status()
                    self.sync_editor()

                self.in_thread(lambda: run_inst(iid, "--autostart"), done2)

        self.in_thread(work, done)

    def do_fix(self):
        iid = self.cur_id
        if iid is None:
            self.toast("Selecciona un GIF de la galería")
            return
        if not is_running_inst(iid):
            self.toast("Ese GIF no se está mostrando")
            return
        got = apply_live_geometry(iid, self.cfg)
        if got is None:
            self.toast("No veo el actor: revisa que el motor GNOME esté activo")
            return
        x, y, w, h = got
        self.sync_editor()
        self.refresh_status()
        self.toast(f"Fijado donde está: {w}x{h} @ {x},{y}")

    def do_start(self):
        iid = self.cur_id
        if not self.cfg["FILE"] or iid is None:
            self.toast("Elige un archivo y pulsa Mostrar")
            return
        adopt_legacy(self.cfg["FILE"])
        write_config(self.cfg, inst_conf(iid))
        self.toast("Iniciando…")

        def done(_res):
            self.refresh_list()
            self.refresh_status()

        self.in_thread(lambda: run_inst(iid, "--autostart"), done)

    def do_stop(self):
        iid = self.cur_id
        self.toast("Deteniendo…")

        def done(_res):
            self.refresh_list()
            self.refresh_status()

        if iid is None:
            done((0, ""))
        else:
            self.in_thread(lambda: run_inst(iid, "--stop"), done)


def main():
    app = GestorApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
