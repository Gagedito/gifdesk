#!/usr/bin/env bash
# gifdesk — reproductor flotante de GIF / WebP animado, de bajo consumo.
# Motor: mpv (libavcodec). Solo GIF y WebP. Soporta transparencias (alfa)
# sobre compositores X11/Wayland. Sin audio, sin OSD, sin bordes.
set -euo pipefail

APP="gifdesk"
VERSION="1.2.0"
SELF_BIN="$(readlink -f "${BASH_SOURCE[0]}")"
# Politicas KWin (kwinrulesrc): 1 no afectar, 2 forzar, 3 aplicar al
# inicio. Se usa APPLY (3, colocar al crear; verificado). El 4 (recordar)
# NO conserva arrastres en la practica: se volvio al 3.
APPLY_RULE=3
REV_KEY="gifdeskrev"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/gifdesk"
INST_DIR="$CONFIG_DIR/instances"
INPUT_CONF="$CONFIG_DIR/input.conf"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/gifdesk"
LOGFILE="$CACHE_DIR/gifdesk.log"

# Instancia: "" = clasica (gifdesk.conf); con --id X usa instances/X.conf
# y proceso/socket/regla propios. Se resuelve en select_instance().
IID=""
CONFIG_FILE="$CONFIG_DIR/gifdesk.conf"
TITLE="$APP"
RULE_ID="$APP"
PIDFILE="$CACHE_DIR/$APP.pid"
SOCKET="$CACHE_DIR/socket"

select_instance() {
    if [[ -n "$IID" ]]; then
        [[ "$IID" =~ ^[A-Za-z0-9_-]{1,32}$ ]] \
            || die "--id solo admite letras, numeros, - y _ (max 32)"
        # "main" es la clasica; no se puede usar como --id (colisionaria).
        [[ "$IID" != "main" ]] || die "--id main reservado (es la instancia clasica)"
        CONFIG_FILE="$INST_DIR/$IID.conf"
    else
        CONFIG_FILE="$CONFIG_DIR/gifdesk.conf"
    fi
    TITLE="$APP${IID:+-$IID}"
    RULE_ID="$TITLE"
    PIDFILE="$CACHE_DIR/$TITLE.pid"
    SOCKET="$CACHE_DIR/socket${IID:+-$IID}"
}

FILE=""
MODE="widget"     # widget | wallpaper
SIZE=""           # ej: 480x476
POS=""            # ej: 100,100 | TR | BR | BL | TL | C
LOCKED="no"       # yes = posicion bloqueada: la ventana ignora el raton
CLICK_THROUGH="no"  # override puntual por CLI (--click-through)
OPACITY="100"       # 0-100: transparencia de la ventana (regla KWin)
FPS="0"             # 0 = ritmo original del GIF; 1-60 = forzar N cuadros/s
# Marcas de "lo puso el CLI": evitan que la config pise un valor por
# defecto pasado explicitamente (--mode widget, --opacity 100...).
CLI_MODE=""
CLI_OPACITY=""
CLI_FPS=""

# Recorta un entero a [lo,hi]. Imprime el valor.
clamp_int() {
    local n="$1" lo="$2" hi="$3"
    [[ "$n" =~ ^[0-9]+$ ]] || n="$lo"
    (( n < lo )) && n="$lo"
    (( n > hi )) && n="$hi"
    printf '%s' "$n"
}

log() { printf '[%s] %s\n' "$APP" "$*" >>"$LOGFILE" 2>/dev/null || true; }

die() { printf 'gifdesk: error: %s\n' "$*" >&2; exit 1; }

msg() { printf '%s\n' "$*"; }

usage() {
    cat <<'EOF'
Uso: gifdesk [OPCIONES]

Muestra un GIF o WebP animado en una ventana flotante sin bordes,
siempre visible, de bajo consumo (mpv + decodificacion por hardware).

Opciones:
  --id NOMBRE      Instancia independiente (proceso, config y regla propios).
                   Sin --id se usa la clasica. Cada GIF lleva su --id
  --save             Guarda FILE/MODE/SIZE/POS/LOCKED en la config (con --id,
                   en su instancia) para que sobreviva reinicios/autostart
  --file RUTA        Archivo .gif / .webp a mostrar
  --mode MODO        widget (defecto) | wallpaper
  --size WxH         Tamano de ventana (ej: 480x476). Por defecto: tamano nativo
  --pos GEOM         Posicion: X,Y | TL | TR | BL | BR | C (defecto: BR).
                       Mejor esfuerzo: en Wayland el compositor puede ignorarla
  --click-through    La ventana ignora el raton (clics pasan a traves)
  --opacity PCT      Transparencia 0-100 (100 = opaco).
                       KDE: regla KWin. GNOME: opacidad real del actor
  --fps N           Velocidad de ESA imagen: 0 = ritmo original del GIF,
                       1-60 = forzar N cuadros por segundo (por instancia)
  --autostart        Sin --id: clasica + todas las instancias (autostart real).
                   Con --id: solo esa instancia segun su config
  --check            Valida el archivo y el entorno sin abrir ventana
  --dry-run          Muestra el comando mpv que se ejecutaria
  --stop             Detiene la instancia en ejecucion
  --stop-all         Detiene todas las instancias
  --status           Muestra si hay instancia corriendo (codigo 0/1)
  --list             Lista instancias y su estado
  --frames-cache     Lista el cache de cuadros del motor GNOME
                        ("ruta WxH N" por linea; uso interno de la GUI:
                        leerlo es gratis, ffprobe son 90 ms por GIF)
  --where            Geometria real "TITULO X Y W H" (KDE: kdotool) o
                       "ID X Y W H" (GNOME: geometria del actor via motor).
                       Con --id, solo esa. Sin --id, todas las visibles
  --get CLAVE        Imprime FILE|MODE|SIZE|POS|LOCKED|OPACITY|FPS|REV de la instancia
  --lock             Bloquea (guarda + relanza si corre, vuelve a su sitio)
  --unlock           Desbloquea (guarda + relanza si corre)
  --rule-only        Sincroniza la regla KWin desde la config, sin lanzar
                       (en GNOME reaplica la instancia visible; uso interno)
  -h, --help         Esta ayuda
  -v, --version      Version

Config (~/.config/gifdesk/gifdesk.conf):
  FILE=/ruta/a/anim.gif
  MODE=widget
  SIZE=480x476
  POS=BR
  LOCKED=no        # yes = posicion bloqueada (la ventana ignora el raton)
  FPS=0            # 0 = ritmo original del GIF; 1-60 = cuadros/s fijos

Ejemplos:
  gifdesk --file ~/Descargas/rem.gif
  gifdesk --file anim.webp --size 320x400 --pos TR
  gifdesk --id rem --file anim.gif --fps 24 --save   # ese GIF a 24 fps
  gifdesk --stop
EOF
}

# ---------- utilidades ----------

have() { command -v "$1" >/dev/null 2>&1; }

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

is_supported() {
    case "$(lower "${1##*.}")" in
        gif|webp) return 0 ;;
        *) return 1 ;;
    esac
}

detect_session() {
    # Imprime: "<tipo>:<escritorio>"  ej: "wayland:kde"
    local tipo="${XDG_SESSION_TYPE:-}"
    local de="${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-unknown}}"
    if [[ -z "$tipo" ]]; then
        if [[ -n "${WAYLAND_DISPLAY:-}" || -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
            tipo="wayland"
        else
            tipo="x11"
        fi
    fi
    printf '%s:%s' "$(lower "$tipo")" "$(lower "$de")"
}

compositor_ok() {
    # Heuristica: en Wayland casi siempre hay compositor.
    # En X11, buscar un compositor conocido corriendo.
    local sess
    sess="$(detect_session)"
    case "$sess" in
        wayland:*) return 0 ;;
    esac
    if pgrep -x picom >/dev/null 2>&1 || pgrep -x compton >/dev/null 2>&1 \
        || pgrep -x kwin_x11 >/dev/null 2>&1 || pgrep -x xfwm4 >/dev/null 2>&1 \
        || pgrep -x mutter >/dev/null 2>&1 || pgrep -x compiz >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

native_size() {
    # Imprime WxH del archivo usando ffprobe si esta disponible.
    local f="$1" out=""
    if have ffprobe; then
        # El '|| true' evita que pipefail+set -e aborte si ffprobe falla.
        out="$(ffprobe -v error -select_streams v:0 \
            -show_entries stream=width,height -of csv=p=0:s=x "$f" 2>/dev/null | head -n1 || true)"
    fi
    if [[ "$out" =~ ^[0-9]+x[0-9]+$ ]]; then
        printf '%s' "$out"
    else
        printf '480x480'
    fi
}

native_fps() {
    # Cuadros/segundo medios del archivo (ffprobe avg_frame_rate, p. ej. "100/3").
    # Vacio si no hay ffprobe o no se puede leer: el llamante lo omite.
    have ffprobe || return 0
    local fr num den
    fr="$(ffprobe -v error -select_streams v:0 \
        -show_entries stream=avg_frame_rate -of csv=p=0 "$1" 2>/dev/null \
        | head -n1 || true)"
    [[ "$fr" =~ ^[0-9]+/[0-9]+$ ]] || return 0
    num="${fr%%/*}"; den="${fr#*/}"
    (( den > 0 )) || return 0
    awk -v n="$num" -v d="$den" 'BEGIN{
        f = n / d
        if (f < 1 || f > 240) exit 1
        printf "%d", (f + 0.5)
    }' 2>/dev/null || true
}

fps_speed() {
    # $1=archivo $2=fps objetivo -> multiplicador para mpv (vacio si no se
    # puede calcular: antes no tocar la velocidad que adivinar).
    local want="$2" nat
    [[ "$want" =~ ^[0-9]+$ ]] || return 0
    (( want > 0 )) || return 0
    nat="$(native_fps "$1")"
    [[ "$nat" =~ ^[0-9]+$ ]] || return 0
    (( nat > 0 )) || return 0
    awk -v n="$nat" -v w="$want" 'BEGIN{
        s = n / w
        if (s < 0.1) s = 0.1
        if (s > 8) s = 8
        printf "%.4f", s
    }' 2>/dev/null || true
}

resolve_pos() {
    # Convierte POS a geometria estilo X11 para mpv ([WxH][{+-}X{+-}Y]).
    # En Wayland el compositor suele ignorar el posicionamiento absoluto
    # (KWin/Hyprland centran o aplican sus propias reglas): best-effort.
    # "C" devuelve vacio para que el compositor centre la ventana.
    local p="$1"
    local up
    up="$(printf '%s' "$p" | tr '[:lower:]' '[:upper:]')"
    case "$up" in
        ""|BR)      printf '%s' "-16-16" ;;
        BL)         printf '%s' "+16-16" ;;
        TR)         printf '%s' "-16+16" ;;
        TL)         printf '%s' "+16+16" ;;
        C|CENTER)   printf '%s' "" ;;
        +*|-*|*%*)  printf '%s' "$p" ;;  # pasada tal cual: +X+Y, -X-Y, 50%:50% ...
        *,*)        # "X,Y" -> "+X+Y"
            if [[ "$p" =~ ^[0-9]+,[0-9]+$ ]]; then
                printf '+%s' "${p/,/+}"
            else
                printf '%s' "-16-16"
            fi ;;
        *)          printf '%s' "-16-16" ;;
    esac
}

# ---------- backend de colocacion (KDE Wayland via regla KWin) ----------
# En Wayland el cliente no puede autoposicionarse: KWin ignora --geometry.
# La solucion es una regla de ventana [gifdesk] (posicion+tamano "al crear"),
# que se sincroniza sola en cada arranque. En X11 basta con --geometry.

is_kde_wayland() {
    [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]] || return 1
    local de="${XDG_CURRENT_DESKTOP:-} ${DESKTOP_SESSION:-}"
    de="$(printf '%s' "$de" | tr '[:upper:]' '[:lower:]')"
    [[ "$de" == *kde* || "$de" == *plasma* ]]
}

# ---------- motor GNOME (extension widgets, sin ventanas) ----------
# En GNOME Wayland no hay ventanas mpv: la extension gifdesk dibuja cada
# instancia como actor Clutter (sin dock/panel/alt-tab, siempre encima,
# opacidad real). Todo pasa por D-Bus org.gifdesk.Widgets.

GNOME_EXT_UUID="gifdesk-widgets@gifdesk.local"
GNOME_BUS="org.gifdesk.Widgets"
GNOME_OBJ="/org/gifdesk/Widgets"
GNOME_IFACE="org.gifdesk.Widgets"
GNOME_MAXF=300

is_gnome() {
    local de="${XDG_CURRENT_DESKTOP:-} ${DESKTOP_SESSION:-}"
    de="$(printf '%s' "$de" | tr '[:upper:]' '[:lower:]')"
    [[ "$de" == *gnome* ]]
}

is_gnome_wayland() {
    is_gnome || return 1
    if [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
        return 0
    fi
    [[ -n "${WAYLAND_DISPLAY:-}" ]]
}

gnome_eid() {
    # Id del motor para la instancia actual ("main" = clasica).
    if [[ -n "$IID" ]]; then printf '%s' "$IID"; else printf 'main'; fi
}

gnome_ext_enabled() {
    # Extension instalada y habilitada (silencio si no hay gnome-extensions).
    # Shell muestra State: ACTIVE (nuevo) o ENABLED (viejo).
    have gnome-extensions || return 1
    gnome-extensions show "$GNOME_EXT_UUID" 2>/dev/null | grep -qE 'State:[[:space:]]*(ENABLED|ACTIVE)'
}

gnome_call() {
    # $1=metodo, resto=args para gdbus. Imprime la respuesta cruda.
    have gdbus || return 1
    local method="$1"; shift
    local out
    out="$(gdbus call --session --dest "$GNOME_BUS" --object-path "$GNOME_OBJ" \
        --method "$GNOME_IFACE.$method" "$@" 2>/dev/null || true)"
    [[ -n "$out" ]] || return 1
    printf '%s' "$out"
}

gnome_unstr() {
    # ('texto\n...',) -> texto con saltos reales. Falla si NONE/vacio.
    local res="$1"
    [[ "$res" == "('"* ]] || return 1
    res="${res#\(\'}"
    res="${res%\',)}"
    res="${res//\\n/$'\n'}"
    [[ -n "$res" && "$res" != "NONE" ]] || return 1
    printf '%s\n' "$res"
}

gnome_engine_ok() {
    # Motor respondiendo (extension activa). Silencioso.
    [[ -n "$(gnome_call List 2>/dev/null)" ]]
}

gnome_engine_status() {
    # Lineas para --check sobre el motor GNOME.
    if gnome_ext_enabled; then
        if gnome_engine_ok; then
            printf 'check: gnome: motor activo (actores Clutter: sin dock ni alt-tab, siempre encima)\n'
        else
            printf 'check: gnome: extension habilitada pero el motor no responde (re-login?)\n'
        fi
    elif have gnome-extensions && gnome-extensions show "$GNOME_EXT_UUID" >/dev/null 2>&1; then
        printf 'check: gnome: extension gifdesk instalada pero DESHABILITADA (activala y re-loguea)\n'
    else
        printf 'check: gnome: extension gifdesk no instalada (install.sh --with-gnome o el flake)\n'
    fi
}

scan_frames_cache() {
    # El motor preextrae cuadros en $CACHE_DIR/frames/<sha1_WxH>/. Leyendo ese
    # cache, la GUI obtiene WxH y nº de cuadros SIN llamar a ffprobe por GIF
    # (~90 ms cada uno: con 500 GIFs eran 45 s de arranque).
    # Imprime "ruta WxH N" por linea. Silencioso si no hay nada.
    local d
    [[ -d "$CACHE_DIR/frames" ]] || return 0
    for d in "$CACHE_DIR/frames"/*_*/; do
        [[ -d "$d" ]] || continue
        local base geo n
        base="$(basename "$d")"
        geo="${base##*_}"
        [[ "$geo" =~ ^[0-9]+x[0-9]+$ ]] || continue
        n="$(compgen -G "$d/f*.png" 2>/dev/null | wc -l)"
        (( n > 0 )) || continue
        printf '%s %s %s\n' "$d" "$geo" "$n"
    done
}

gnome_frames_dir() {
    # $1=file $2=W $3=H (0 = nativo). Imprime el dir cache con f%03d.png
    # al tamano final + durations.txt (ms separados por espacios).
    # Clave por contenido+tamano: la 2a vez es instantaneo.
    local f="$1" w="$2" h="$3"
    have ffmpeg && have ffprobe \
        || die "GNOME necesita ffmpeg+ffprobe (el motor pre-extrae los cuadros)"
    [[ "$w" =~ ^[0-9]+$ && "$w" -gt 0 ]] || w=0
    [[ "$h" =~ ^[0-9]+$ && "$h" -gt 0 ]] || h=0
    if (( w == 0 || h == 0 )); then
        local nat
        nat="$(native_size "$f")"
        w="${nat%x*}"; h="${nat#*x}"
    fi
    local key dir
    key="$(sha1sum "$f" 2>/dev/null | cut -d' ' -f1 | head -c 16)"
    [[ -n "$key" ]] || die "no se pudo leer $f"
    dir="$CACHE_DIR/frames/${key}_${w}x${h}"
    if [[ -f "$dir/durations.txt" ]] && compgen -G "$dir/f*.png" >/dev/null; then
        printf '%s' "$dir"
        return 0
    fi
    rm -rf "$dir"; mkdir -p "$dir"
    ffmpeg -v error -y -i "$f" -frames:v "$GNOME_MAXF" \
        -vf "scale=${w}:${h}" "$dir/f%03d.png" 2>/dev/null \
        || die "ffmpeg no pudo extraer cuadros de $f"
    local npng
    npng="$(compgen -G "$dir/f*.png" | wc -l)"
    (( npng > 0 )) || { rm -rf "$dir"; die "sin cuadros extraibles en $f"; }
    # Duraciones por cuadro via ffprobe (s -> ms, 20..2000); respaldo 100.
    local durs=() line ms n=0
    while IFS= read -r line; do
        ms="$(awk -v s="$line" 'BEGIN{ m=int(s*1000+0.5); if(m<20)m=20; if(m>2000)m=2000; print m }' 2>/dev/null || true)"
        [[ "$ms" =~ ^[0-9]+$ ]] || ms=100
        durs+=("$ms"); n=$((n+1))
        (( n >= npng )) && break
    done < <(ffprobe -v error -select_streams v:0 \
        -show_entries frame=pkt_duration_time -of csv=p=0 "$f" 2>/dev/null || true)
    local out=() i
    for ((i = 0; i < npng; i++)); do
        out+=("${durs[$i]:-100}")
    done
    printf '%s' "${out[*]}" >"$dir/durations.txt"
    printf '%s' "$dir"
}

gnome_show_current() {
    # Muestra la instancia actual en el motor con FILE/SIZE/POS/LOCKED/
    # OPACITY (globales ya resueltas). CLICK_THROUGH fuerza bloqueo puntual.
    local eid lock
    eid="$(gnome_eid)"
    local gw=0 gh=0
    if [[ "$SIZE" =~ ^([0-9]+)x([0-9]+)$ ]]; then
        gw="${BASH_REMATCH[1]}"; gh="${BASH_REMATCH[2]}"
    fi
    lock="false"
    if [[ "$LOCKED" == "yes" || "$CLICK_THROUGH" == "yes" ]]; then lock="true"; fi
    local op="$OPACITY"; [[ "$op" =~ ^[0-9]+$ ]] || op=100
    op="$(clamp_int "$op" 0 100)"
    local fps; fps="$(clamp_int "$FPS" 0 60)"
    local pos="$POS"; [[ -n "$pos" ]] || pos="BR"
    # Espera breve al motor (en login la extension aun puede estar cargando).
    local tries=0
    while (( tries < 5 )) && ! gnome_engine_ok; do
        sleep 1; tries=$((tries+1))
    done
    # Cuadros pre-extraidos (cache; la 1a vez de un GIF grande tarda segundos).
    local fdir durs out
    fdir="$(gnome_frames_dir "$FILE" "$gw" "$gh")"
    durs="$(cat "$fdir/durations.txt" 2>/dev/null || true)"
    [[ -n "$durs" ]] || die "cache de cuadros vacia ($fdir)"
    # El motor exige W/H finales: van codificados en el nombre del cache.
    geo="${fdir##*_}"; gw="${geo%x*}"; gh="${geo##*x}"
    [[ "$gw" =~ ^[0-9]+$ && "$gh" =~ ^[0-9]+$ && "$gw" -gt 0 && "$gh" -gt 0 ]] \
        || die "cache de cuadros invalida ($fdir)"
    out="$(gnome_call Show "$eid" "$FILE" "$fdir" "$durs" "$pos" "$gw" "$gh" "$lock" "$op" "$fps")" \
        || die "motor GNOME no responde (extension inactiva?); activala, re-loguea y reintenta"
    [[ "$out" == "(true,)"* ]] \
        || die "el motor no pudo mostrar $FILE (cuadros ilegibles?)"
    msg "gifdesk mostrando: $FILE (motor GNOME, id $eid)"
}

gnome_is_showing() {  # $1=id
    local out
    out="$(gnome_call IsShowing "$1")" || return 1
    [[ "$out" == "(true,)"* ]]
}

gnome_cmd_stop() {
    # Detiene la instancia actual en el motor.
    local eid
    eid="$(gnome_eid)"
    if gnome_is_showing "$eid"; then
        gnome_call Stop "$eid" >/dev/null 2>&1 || true
        msg "gifdesk detenido (id $eid)."
    else
        msg "gifdesk no estaba en ejecucion."
    fi
}

gnome_cmd_stop_all() {
    if gnome_engine_ok; then
        gnome_call StopAll >/dev/null 2>&1 || true
    fi
    msg "todas las instancias detenidas"
}

gnome_cmd_status() {
    local eid
    eid="$(gnome_eid)"
    if gnome_is_showing "$eid"; then
        msg "gifdesk en ejecucion (motor GNOME, id $eid)."
    else
        msg "gifdesk detenido."
        return 1
    fi
}

gnome_cmd_where() {
    # Geometria real "ID X Y W H" del motor. Con --id solo esa; sin --id todas.
    local want=""
    [[ -n "$IID" ]] && want="$(gnome_eid)"
    local out
    out="$(gnome_call Geometry "$want")" \
        || die "--where sin motor GNOME (extension inactiva?); coloca con el editor numerico"
    gnome_unstr "$out" \
        || die "no se ve instancia gifdesk en pantalla"
}

gnome_cmd_lock() {  # $1=yes|no
    # Guarda LOCKED y lo aplica en vivo si se muestra (sin relanzar).
    [[ -f "$CONFIG_FILE" ]] || die "sin instancia (muestra el GIF primero)"
    MODE="widget"; FILE=""; SIZE=""; POS=""; LOCKED="no"; OPACITY="100"; FPS="0"
    load_config
    if [[ "$LOCKED" != "$1" ]]; then
        sed -i "s/^[[:space:]]*LOCKED=.*/LOCKED=$1/" "$CONFIG_FILE"
        grep -qE '^[[:space:]]*LOCKED=' "$CONFIG_FILE" \
            || echo "LOCKED=$1" >>"$CONFIG_FILE"
        LOCKED="$1"
    fi
    local eid lock
    eid="$(gnome_eid)"
    if gnome_is_showing "$eid"; then
        lock="false"; [[ "$LOCKED" == "yes" ]] && lock="true"
        gnome_call SetLocked "$eid" "$lock" >/dev/null 2>&1 \
            || die "no se pudo aplicar el bloqueo (motor no responde)"
        if [[ "$LOCKED" == "yes" ]]; then
            msg "bloqueado (ignora el raton)."
        else
            msg "desbloqueado (se puede mover)."
        fi
    else
        msg "guardado (se aplicara al mostrar)"
    fi
}

gnome_cmd_ruleonly() {
    # Reaplica la instancia visible con su config (equivale a Aplicar).
    MODE="widget"; FILE=""; SIZE=""; POS=""; LOCKED="no"; OPACITY="100"; FPS="0"
    load_config
    [[ -z "$FILE" || ! -f "$FILE" ]] && die "sin archivo para regla"
    local eid
    eid="$(gnome_eid)"
    if gnome_is_showing "$eid"; then
        gnome_show_current
    else
        msg "guardado (se aplicara al mostrar)"
    fi
}

gnome_dry_run() {
    # Plan del actor sin mostrar nada.
    local size="${SIZE:-nativo}" pos="${POS:-BR}" fps
    fps="$(clamp_int "$FPS" 0 60)"
    printf 'actor id=%s file=%s size=%s pos=%s locked=%s opacity=%s fps=%s (motor GNOME, sin ventana)\n' \
        "$(gnome_eid)" "$FILE" "$size" "$pos" "$LOCKED" "$OPACITY" \
        "$([[ "$fps" == "0" ]] && echo 'original' || echo "$fps")"
}

kwin_screen() {
    # "1366x768" de la salida de supportInformation. Vacio si falla.
    have qdbus6 || return 1
    timeout 8 qdbus6 org.kde.KWin /KWin org.kde.KWin.supportInformation 2>/dev/null \
        | sed -n 's/^[[:space:]]*Geometry: 0,0,\([0-9][0-9]*x[0-9][0-9]*\).*/\1/p' \
        | head -n1
}

kwin_abspos() {
    # $1=pos $2=gif_w $3=gif_h $4=scr_w $5=scr_h -> "X,Y" (margen 16).
    local pos="$1" gw="$2" gh="$3" sw="$4" sh="$5" m=16
    case "$(printf '%s' "$pos" | tr '[:lower:]' '[:upper:]')" in
        ""|BR) printf '%d,%d' "$((sw-gw-m))" "$((sh-gh-m))" ;;
        BL)    printf '%d,%d' "$m" "$((sh-gh-m))" ;;
        TR)    printf '%d,%d' "$((sw-gw-m))" "$m" ;;
        TL)    printf '%d,%d' "$m" "$m" ;;
        C)     printf '%d,%d' "$(((sw-gw)/2))" "$(((sh-gh)/2))" ;;
        *,*)   printf '%s' "$pos" ;;
        *)     printf '%d,%d' "$((sw-gw-m))" "$((sh-gh-m))" ;;
    esac
}

ensure_kwin_rule() {
    # $1=X $2=Y $3=W $4=H $5=REV $6=OPACIDAD(0-100). Escribe la regla solo
    # ante un cambio EXPLICITO (REV distinto al guardado): asi no pisa lo
    # que KWin haya recordado de tus arrastres. Primera vez: escribe siempre.
    # La opacidad se fuerza (aplica en vivo sin relanzar).
    local x="$1" y="$2" w="$3" h="$4" rev="$5" op="$6"
    have kwriteconfig6 || return 0
    have qdbus6 || return 0
    local stored rpos rsize rop rpr rsr
    stored="$(kreadconfig6 --file kwinrulesrc --group "$RULE_ID" --key "$REV_KEY" 2>/dev/null || true)"
    rpos="$(kreadconfig6 --file kwinrulesrc --group "$RULE_ID" --key position 2>/dev/null || true)"
    rsize="$(kreadconfig6 --file kwinrulesrc --group "$RULE_ID" --key size 2>/dev/null || true)"
    rop="$(kreadconfig6 --file kwinrulesrc --group "$RULE_ID" --key opacityactive 2>/dev/null || true)"
    rpr="$(kreadconfig6 --file kwinrulesrc --group "$RULE_ID" --key positionrule 2>/dev/null || true)"
    rsr="$(kreadconfig6 --file kwinrulesrc --group "$RULE_ID" --key sizerule 2>/dev/null || true)"
    if [[ -n "$stored" && "$stored" == "$rev" && "$rpos" == "$x,$y" \
        && "$rsize" == "$w,$h" && "$rop" == "$op" \
        && "$rpr" == "$APPLY_RULE" && "$rsr" == "$APPLY_RULE" ]]; then
        return 0
    fi
        # Titulo anclado regex: evita que "gifdesk" empareje "gifdesk-ram".
        kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key Description "$TITLE"
        kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key title "^${TITLE}$"
        kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key titlematch 3
        kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key position "$x,$y"
        kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key positionrule "$APPLY_RULE"
        kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key size "$w,$h"
        kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key sizerule "$APPLY_RULE"
        kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key "$REV_KEY" "$rev"
        kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key opacityactive "$op"
        kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key opacityactiverule 2
        kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key opacityinactive "$op"
        kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key opacityinactiverule 2
        local rules
        rules="$(kreadconfig6 --file kwinrulesrc --group General --key rules 2>/dev/null || true)"
        case ",$rules," in
            *",$RULE_ID,"*) ;;
            *) kwriteconfig6 --file kwinrulesrc --group General --key rules "${rules:+$rules,}$RULE_ID"
               kwriteconfig6 --file kwinrulesrc --group General --key count \
                   "$(tr ',' '\n' <<<"${rules:+$rules,}$RULE_ID" | grep -c .)" ;;
        esac
        # reconfigure con timeout: qdbus sin limite espera 25 s si KWin
        # esta ocupado; no debe colgar el arranque.
        timeout 8 qdbus6 org.kde.KWin /KWin org.kde.KWin.reconfigure 2>/dev/null || true
        log "regla kwin sincronizada rev=$rev: $x,$y ${w}x$h"
}

conf_rev() {
    # REV guardado en una conf (0 si falta/invalido). No falla nunca.
    local r
    r="$(grep -E '^[[:space:]]*REV=' "$1" 2>/dev/null | head -n1 \
        | sed -e 's/^[[:space:]]*REV=//' -e 's/[^0-9]//g' || true)"
    [[ "$r" =~ ^[0-9]+$ ]] && printf '%s' "$r" || printf '0'
}

bump_rev() {
    # Siguiente REV para un cambio explicito del editor/CLI. Imprime el nuevo.
    local cur next
    cur="$(conf_rev "$1")"
    next=$((cur + 1))
    if grep -qE '^[[:space:]]*REV=' "$1" 2>/dev/null; then
        sed -i "s/^[[:space:]]*REV=.*/REV=$next/" "$1"
    else
        echo "REV=$next" >>"$1"
    fi
    printf '%s' "$next"
}

sync_placement() {
    # $1=pos $2=size(WxH) $3=opacidad. En KDE Wayland escribe la regla
    # (solo si la REV cambio = orden explicita); resto: nada.
    # (En GNOME no hay ventanas ni reglas: el motor coloca el actor.)
    if is_kde_wayland; then
        local scr gw gh op
        scr="$(kwin_screen)" || return 0
        [[ -n "$scr" ]] || return 0
        gw="${2%x*}"; gh="${2#*x}"
        [[ "$gw" =~ ^[0-9]+$ && "$gh" =~ ^[0-9]+$ ]] || return 0
        op="$3"; [[ "$op" =~ ^[0-9]+$ ]] || op=100
        (( op < 0 )) && op=0; (( op > 100 )) && op=100
        local xy rev
        xy="$(kwin_abspos "$1" "$gw" "$gh" "${scr%x*}" "${scr#*x}")"
        rev="$(conf_rev "$CONFIG_FILE")"
        ensure_kwin_rule "${xy%,*}" "${xy#*,}" "$gw" "$gh" "$rev" "$op"
        return 0
    fi
}

running_pid() {    if [[ -f "$PIDFILE" ]]; then
        local pid
        pid="$(cat "$PIDFILE" 2>/dev/null || true)"
        if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
            printf '%s' "$pid"
            return 0
        fi
    fi
    # Respaldo: buscar mpv con nuestro titulo (unico por instancia).
    # Anclado al final o espacio para no confundir gifdesk con gifdesk-otro.
    local alt
    alt="$(pgrep -f -- "--title=${TITLE}( |$)" 2>/dev/null | head -n1 || true)"
    if [[ -n "$alt" ]]; then
        printf '%s' "$alt"
        return 0
    fi
    return 1
}

file_of() {
    # Valor de FILE= en una conf (sin comillas). Vacio si no hay.
    # Nunca falla (pipefail no debe abortar a quien la llama).
    grep -E '^[[:space:]]*FILE=' "$1" 2>/dev/null | head -n1 \
        | sed -e 's/^[[:space:]]*FILE=//' -e 's/^"//' -e 's/"[[:space:]]*$//' || true
}

has_file() {
    [[ -n "$(file_of "$1")" ]]
}

known_ids() {
    # Imprime un id por linea: main (si la clasica tiene FILE) + instances/.
    if has_file "$CONFIG_DIR/gifdesk.conf"; then
        printf 'main\n'
    fi
    mkdir -p "$INST_DIR" 2>/dev/null || true
    local f id
    for f in "$INST_DIR"/*.conf; do
        [[ -e "$f" ]] || continue
        id="$(basename "$f" .conf)"
        [[ "$id" =~ ^[A-Za-z0-9_-]{1,32}$ ]] || continue
        printf '%s\n' "$id"
    done
}

list_instances() {
    # Sin relanzar el binario por instancia: en GNOME el motor responde con
    # la lista completa (una llamada); en mpv, un chequeo en proceso. Con 500
    # instancias, re-ejecutarse por cada una costsegundos.
    local i ff st any=no
    local -A on=()
    if is_gnome_wayland; then
        local ids e
        ids="$(gnome_call List 2>/dev/null || true)"
        if [[ "$ids" == "("*")" && "$ids" != *NONE* ]]; then
            while IFS= read -r e; do
                [[ -n "$e" ]] && on["$e"]=1
            done < <(gnome_unstr "$ids" 2>/dev/null || true)
        fi
    fi
    while IFS= read -r i; do
        any=yes
        if [[ "$i" == "main" ]]; then
            ff="$(file_of "$CONFIG_DIR/gifdesk.conf")"
        else
            ff="$(file_of "$INST_DIR/$i.conf")"
        fi
        if [[ -n "${on[$i]+x}" ]]; then
            st="corriendo"
        elif (( ${#on[@]} > 0 )) && is_gnome_wayland; then
            st="detenida"
        else
            # Sin lista del motor (mpv, o motor sin respuesta): chequeo directo.
            if [[ "$i" == "main" ]]; then
                IID=""; select_instance
            else
                IID="$i"; select_instance
            fi
            if running_pid >/dev/null 2>&1 || gnome_is_showing "$i"; then
                st="corriendo"
            else
                st="detenida"
            fi
        fi
        printf '%-16s %-10s %s\n' "$i" "$st" "${ff:-"(sin archivo)"}"
    done < <(known_ids)
    [[ "$any" == "yes" ]] || msg "sin instancias (usa la GUI o --id NOMBRE --file ... --save)"
}

run_autostart() {
    # Lanza ESTA instancia (IID ya resuelto) segun su config. Solo config.
    MODE="widget"; FILE=""; SIZE=""; POS=""; LOCKED="no"; OPACITY="100"; FPS="0"
    load_config
    [[ -z "$FILE" ]] && die "autostart sin FILE ($CONFIG_FILE)"
    if is_gnome_wayland; then
        # En GNOME el motor es la extension (actores, no ventanas mpv).
        [[ "$MODE" == "wallpaper" ]] && die "--mode wallpaper no soportado en GNOME (usa widget)"
        gnome_show_current
        return $?
    fi
    [[ "$MODE" =~ ^(widget|wallpaper)$ ]] || die "MODE invalido en $CONFIG_FILE"
    launch "$FILE" "$MODE" "$SIZE" "$POS" "no"
}

autostart_all() {
    # Sin --id: clasica (si tiene FILE) + todas las de instances/.
    local n=0 i
    while IFS= read -r i; do
        if [[ "$i" == "main" ]]; then
            "$SELF_BIN" --autostart-legacy >/dev/null 2>&1 && n=$((n+1)) || true
        else
            "$SELF_BIN" --id "$i" --autostart >/dev/null 2>&1 && n=$((n+1)) || true
        fi
    done < <(known_ids)
    [[ $n -gt 0 ]] || die "nada que mostrar (sin FILE en configs)"
    msg "instancias lanzadas: $n"
}

cmd_where() {
    # Geometria REAL via kdotool (KDE): "TITULO X Y W H" por linea.
    # (En GNOME se resuelve en main() via el motor; aqui solo KDE/X11.)
    # Con --id solo esa instancia; sin --id, todas las visibles.
    have kdotool || die "--where necesita kdotool (sudo pacman -S kdotool)"
    local u name geo x y w h found="no" line
    while IFS= read -r u; do
        [[ -n "$u" ]] || continue
        name="$(kdotool getwindowname "$u" 2>/dev/null | head -n1)"
        [[ "$name" =~ ^gifdesk(-[A-Za-z0-9_-]+)?$ ]] || continue
        if [[ -n "$IID" && "$name" != "$TITLE" ]]; then
            continue
        fi
        geo="$(kdotool getwindowgeometry "$u" 2>/dev/null)"
        line="$(grep -E 'Position:' <<<"$geo" | head -n1 | grep -oE '[0-9-]+,[0-9-]+')"
        x="${line%,*}"; y="${line#*,}"
        line="$(grep -E 'Geometry:' <<<"$geo" | head -n1 | grep -oE '[0-9-]+x[0-9-]+')"
        w="${line%x*}"; h="${line#*x}"
        [[ -n "$x" && -n "$y" && -n "$w" && -n "$h" ]] || continue
        printf '%s %s %s %s %s\n' "$name" "$x" "$y" "$w" "$h"
        found="yes"
    done < <(kdotool search --name "gifdesk" 2>/dev/null)
    [[ "$found" == "yes" ]] || die "no se ve ventana gifdesk en pantalla"
}

cmd_stop() {
    # Detiene TODOS los mpv de esta instancia (pidfile + barrido por
    # titulo, para no dejar huerfanos de carreras pasadas).
    with_instance_lock
    touch "$CACHE_DIR/stopped-$TITLE" 2>/dev/null || true
    if stop_existing; then
        rm -f "$PIDFILE" "$SOCKET"
        msg "gifdesk detenido."
    else
        rm -f "$PIDFILE" "$SOCKET"
        msg "gifdesk no estaba en ejecucion."
    fi
}

cmd_stop_all() {
    # Detiene la clasica + todas las instancias.
    local i
    while IFS= read -r i; do
        if [[ "$i" == "main" ]]; then
            IID="" select_instance
        else
            IID="$i" select_instance
        fi
        cmd_stop >/dev/null 2>&1 || true
    done < <(known_ids)
    msg "todas las instancias detenidas"
}

cmd_status() {
    local pid
    if pid="$(running_pid)"; then
        msg "gifdesk en ejecucion (pid $pid)."
    else
        msg "gifdesk detenido."
        return 1
    fi
}

cmd_check() {
    local f="$1" rc=0
    if [[ -z "$f" ]]; then
        printf 'check: falta --file (o FILE en gifdesk.conf)\n' >&2; rc=1
    elif [[ ! -f "$f" ]]; then
        printf 'check: no existe: %s\n' "$f" >&2; rc=1
    elif ! is_supported "$f"; then
        printf 'check: extension no soportada (solo .gif / .webp): %s\n' "$f" >&2; rc=1
    else
        printf 'check: archivo OK: %s\n' "$f"
        if have ffprobe; then
            ffprobe -v error -select_streams v:0 \
                -show_entries stream=codec_name,width,height,pix_fmt,avg_frame_rate,nb_frames \
                -of default=noprint_wrappers=1 "$f" 2>&1 || rc=1
        fi
    fi
    if is_gnome_wayland; then
        printf 'check: motor: extension (mpv no necesario: renderizan los actores Clutter)\n'
    elif have mpv; then
        printf 'check: mpv OK: %s\n' "$(mpv --version 2>/dev/null | head -n1)"
    else
        printf 'check: falta mpv en el PATH\n' >&2; rc=1
    fi
    printf 'check: sesion: %s\n' "$(detect_session)"
    if compositor_ok; then
        printf 'check: compositor: detectado (transparencia disponible)\n'
    else
        printf 'check: compositor: NO detectado (la transparencia puede verse negra)\n' >&2
    fi
    if is_kde_wayland; then
        printf 'check: backend: KDE Wayland (regla KWin: posicion/tamano/opacidad)\n'
    elif is_gnome_wayland; then
        printf 'check: backend: GNOME (actores Clutter via extension: sin dock ni alt-tab)\n'
        gnome_engine_status
    else
        printf 'check: backend: generico (%s; posicion best-effort)\n' "$(detect_session)"
    fi
    return "$rc"
}

build_mpv_args() {
    # $1=file $2=mode $3=size $4=pos ; imprime args separados por NUL.
    local f="$1" mode="$2" size="$3" pos="$4"
    local geo autofit
    if [[ -z "$size" ]]; then
        size="$(native_size "$f")"
    fi
    autofit="$size"
    geo="$(resolve_pos "$pos")"

    # Base de bajo consumo: sin audio, sin OSD, loop infinito,
    # decodificacion por hardware cuando exista, respeto al timing
    # original del GIF/WebP (sin --untimed, que dispararia la CPU).
    local -a a=(
        --no-audio
        --osd-level=0
        --osc=no
        --no-input-default-bindings
        --input-vo-keyboard=no
        --cursor-autohide=no
        --keep-open=yes
        --loop-file=inf
        --untimed=no
        --framedrop=no
        --window-scale=1
        --vo=gpu-next,gpu,dmabuf-wayland,wlshm,x11
        --hwdec=auto-safe
        --title="$TITLE"
        --wayland-app-id="$TITLE"
        --input-ipc-server="$SOCKET"
    )
    # Atajos extra sobre el GIF si el usuario los define en input.conf.
    if [[ -f "$INPUT_CONF" ]]; then
        a+=(--input-conf="$INPUT_CONF")
    fi

    # Velocidad: fps objetivo -> multiplicador de mpv. Con FPS=0 no se toca.
    local speed
    speed="$(fps_speed "$f" "$FPS")"
    if [[ -n "$speed" ]]; then
        a+=(--speed="$speed")
    fi

    if [[ "$mode" == "wallpaper" ]]; then
        # Fondo de pantalla falso: pantalla completa detras de todo.
        a+=(
            --fullscreen=yes
            --ontop=no
            --on-all-workspaces=yes
            --show-in-taskbar=no
            --border=no
            --keepaspect-window=no
            --background-color=#FF000000
        )
    else
        # Widget flotante: solo el gif, con alfa real (#00000000).
        # En KDE Wayland la posicion/tamano se imponen via regla KWin
        # (el compositor ignora --geometry); en X11 vale --geometry.
        # La opacidad tambien va por regla (mpv no tiene --opacity).
        sync_placement "$pos" "$size" "$OPACITY"
        a+=(
            --border=no
            --ontop=yes
            --on-all-workspaces=yes
            --show-in-taskbar=no
            --keepaspect-window=yes
            --autofit="$autofit"
            --background-color=#00000000
        )
        # Sin geometria ("C") el compositor centra la ventana.
        if [[ -n "$geo" ]]; then
            a+=(--geometry="$geo")
        fi
    fi

    if [[ "$CLICK_THROUGH" == "yes" || "$LOCKED" == "yes" ]]; then
        a+=(--input-cursor-passthrough=yes --input-cursor=no)
    fi

    a+=(-- "$f")
    printf '%s\0' "${a[@]}"
}

preflight_mpv_args() {
    # Adapta los flags al mpv instalado SIN ejecutarlo (un pre-vuelo con
    # --vo=null se colgaba 15 s en bucle): se listan las opciones reales
    # una vez y se quita lo desconocido (mpv viejos/nuevos). Rapido (<0.1s)
    # y determinista. Los VALORES exoticos no se validan (riesgo residual
    # minimo; el lanzamiento los reportaria en el log).
    local -a pargs=("$@")
    local optlist name alt t kept=()
    optlist="$(mpv --list-options 2>/dev/null || true)"
    for t in "${pargs[@]}"; do
        if [[ "$t" == --* && "$t" != "--" ]]; then
            name="${t#--}"; name="${name%%=*}"
            # mpv lista la forma positiva (--audio); --no-X es negacion valida.
            alt="$name"
            [[ "$name" == no-* ]] && alt="${name#no-}"
            if ! grep -qE "^ --${name}([[:space:]]|$)" <<<"$optlist" \
            && ! grep -qE "^ --${alt}([[:space:]]|$)" <<<"$optlist"; then
                log "preflight: flag no soportada por este mpv, quitada: --$name"
                continue
            fi
        fi
        kept+=("$t")
    done
    printf '%s\0' "${kept[@]}"
}

with_instance_lock() {
    # Exclusion mutua SOLO para operaciones sin spawn (cmd_stop): el FD se
    # hereda a los hijos, asi que JAMAS se mantiene abierto al lanzar mpv
    # (el lock duraria lo que el mpv y cada arranque esperaria 15 s).
    local lockf="$CACHE_DIR/$TITLE.lock"
    exec {GIFDESK_LOCK_FD}>"$lockf" 2>/dev/null || return 0
    if have flock; then
        flock -w 15 "$GIFDESK_LOCK_FD" 2>/dev/null || true
    fi
}

stop_existing() {
    # Mata todos los mpv de esta instancia (sin lock: lo pone el llamante).
    local pids p
    pids="$(pgrep -f -- "--title=${TITLE}( |$)" 2>/dev/null || true)"
    if pid="$(running_pid)"; then
        pids="$(printf '%s\n%s' "$pid" "$pids")"
    fi
    pids="$(printf '%s\n' "$pids" | grep -E '^[0-9]+$' | sort -u || true)"
    [[ -n "$pids" ]] || return 1
    for p in $pids; do
        kill "$p" 2>/dev/null || true
    done
    sleep 0.5
    for p in $pids; do
        if kill -0 "$p" 2>/dev/null; then
            kill -9 "$p" 2>/dev/null || true
        fi
    done
    return 0
}

launch() {
    local f="$1" mode="$2" size="$3" pos="$4" dry="$5"
    local -a args=()
    while IFS= read -r -d '' tok; do
        args+=("$tok")
    done < <(build_mpv_args "$f" "$mode" "$size" "$pos")

    if [[ "$dry" == "yes" ]]; then
        printf 'mpv'
        printf ' %q' "${args[@]}"
        printf '\n'
        return 0
    fi

    # Pre-vuelo: adapta los flags al mpv instalado (viejos/nuevos).
    local -a final=()
    while IFS= read -r -d '' tok; do
        final+=("$tok")
    done < <(preflight_mpv_args "${args[@]}")
    args=("${final[@]}")

    if ! compositor_ok; then
        printf 'gifdesk: aviso: no se detecto compositor; la transparencia puede verse negra.\n' >&2
        log "aviso: sin compositor, alfa degradado"
    fi

    # Reemplazo serializado: el stop va en subshell con lock propio (ese
    # proceso muere ahi mismo: ningun FD vivo llega al mpv nuevo). Siempre
    # se pasa por el lock aunque no corra nada, para ordenar arranques
    # simultaneos (doble clic): el ultimo gana, sin huerfanos vivos a medias.
    ( flock -w 15 9 || exit 7
      stop_existing >/dev/null 2>&1 || true
    ) 9>"$CACHE_DIR/$TITLE.lock" 2>/dev/null || true
    mkdir -p "$CACHE_DIR"
    rm -f "$SOCKET"
    # Rotar log: mpv escribe una linea de estado por cuadro (a 50fps crece
    # rapidisimo). Conservar solo la cola para no inflar disco ni IO.
    if [[ -f "$LOGFILE" ]]; then
        tail -c 262144 "$LOGFILE" >"$LOGFILE.tmp" 2>/dev/null || true
        mv -f "$LOGFILE.tmp" "$LOGFILE" 2>/dev/null || true
    fi
    log "inicio: id=${IID:-main} file=$f mode=$mode size=${size:-auto} pos=${pos:-BR} locked=$LOCKED sesion=$(detect_session)"
    # setsid + nohup para sobrevivir al cierre del terminal/autostart.
    setsid nohup mpv "${args[@]}" >>"$LOGFILE" 2>&1 < /dev/null &
    local pid=$!
    printf '%s' "$pid" >"$PIDFILE"
    # Darle un momento y comprobar que no murio al instante.
    sleep 0.6
    if kill -0 "$pid" 2>/dev/null; then
        msg "gifdesk mostrando: $f (pid $pid)"
        watch_mpv "$pid" "$f"
    else
        rm -f "$PIDFILE"
        die "mpv termino de inmediato; revisa $LOGFILE"
    fi
}

watch_mpv() {
    # Vigia: si el mpv muere SIN que nadie pidiera --stop, dejarlo escrito
    # en el log (diagnostico de cuelgues/crashes). Cuesta ~nada (sleep).
    local pid="$1" f="$2"
    local flag="$CACHE_DIR/stopped-$TITLE" plog="$LOGFILE"
    rm -f "$flag"
    ( for ((i = 0; i < 360; i++)); do
          kill -0 "$pid" 2>/dev/null || break
          sleep 10
      done
      kill -0 "$pid" 2>/dev/null && return 0
      if [[ -f "$flag" ]]; then
          rm -f "$flag"
      else
          printf '[%s] MUERTE INESPERADA pid %s (%s): no fue --stop; revisa arriba errores mpv\n' \
              "$APP" "$pid" "$f" >>"$plog" 2>/dev/null || true
      fi ) >>"$plog" 2>&1 < /dev/null &
    disown 2>/dev/null || true
}

load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        # Solo claves conocidas, para no ejecutar nada arbitrario.
        local k v
        while IFS='=' read -r k v; do
            k="$(printf '%s' "$k" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
            v="$(printf '%s' "$v" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//')"
            [[ "$k" =~ ^#.*$ || -z "$k" ]] && continue
            # Ramas con 'if' (no '&&'): un test falso como ultima orden del
            # cuerpo dejaria al bucle con estado 1 y 'set -e' abortaria.
            case "$k" in
                FILE) if [[ -z "$FILE" ]]; then FILE="$v"; fi ;;
                MODE) if [[ -z "${CLI_MODE:-}" && "$MODE" == "widget" && "$v" =~ ^(widget|wallpaper)$ ]]; then MODE="$v"; fi ;;
                SIZE) if [[ -z "$SIZE" ]]; then SIZE="$v"; fi ;;
                POS)  if [[ -z "$POS" ]]; then POS="$v"; fi ;;
                LOCKED) if [[ "$LOCKED" == "no" && "$v" =~ ^(yes|no)$ ]]; then LOCKED="$v"; fi ;;
                OPACITY) if [[ -z "${CLI_OPACITY:-}" && "$OPACITY" == "100" && "$v" =~ ^[0-9]+$ ]]; then
                    OPACITY="$(clamp_int "$v" 0 100)"
                fi ;;
                FPS) if [[ -z "${CLI_FPS:-}" && "$FPS" == "0" && "$v" =~ ^[0-9]+$ ]]; then
                    FPS="$(clamp_int "$v" 0 60)"
                fi ;;
            esac
        done <"$CONFIG_FILE"
    fi
    return 0
}

main() {
    local dry="no" do_check="no" autostart="no" action="" getkey="" newlock="" save="no"
    mkdir -p "$CACHE_DIR" "$INST_DIR" 2>/dev/null || true

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --id)        [[ $# -ge 2 ]] || die "--id necesita un nombre"; IID="$2"; shift 2 ;;
            --id=*)      IID="${1#*=}"; shift ;;
            --file)      [[ $# -ge 2 ]] || die "--file necesita un valor"; FILE="$2"; shift 2 ;;
            --file=*)    FILE="${1#*=}"; shift ;;
            --mode)      [[ $# -ge 2 ]] || die "--mode necesita un valor"; MODE="$2"; CLI_MODE=1; shift 2 ;;
            --mode=*)    MODE="${1#*=}"; CLI_MODE=1; shift ;;
            --size)      [[ $# -ge 2 ]] || die "--size necesita un valor"; SIZE="$2"; shift 2 ;;
            --size=*)    SIZE="${1#*=}"; shift ;;
            --pos)       [[ $# -ge 2 ]] || die "--pos necesita un valor"; POS="$2"; shift 2 ;;
            --pos=*)     POS="${1#*=}"; shift ;;
            --click-through) CLICK_THROUGH="yes"; shift ;;
            --opacity)
                [[ $# -ge 2 ]] || die "--opacity necesita un valor 0-100"
                OPACITY="$2"; CLI_OPACITY=1; shift 2
                OPACITY="$(clamp_int "$OPACITY" 0 100)" ;;
            --fps)
                [[ $# -ge 2 ]] || die "--fps necesita un valor 0-60"
                FPS="$2"; CLI_FPS=1; shift 2
                [[ "$FPS" =~ ^[0-9]+$ ]] || die "--fps 0-60 (0 = original)"
                FPS="$(clamp_int "$FPS" 0 60)" ;;
            --save)      save="yes"; shift ;;
            --autostart) autostart="yes"; shift ;;
            --autostart-legacy) autostart="legacy"; shift ;;
            --check)     do_check="yes"; shift ;;
            --dry-run)   dry="yes"; shift ;;
            --stop)      action="stop"; shift ;;
            --stop-all)  action="stopall"; shift ;;
            --status)    action="status"; shift ;;
            --list)      action="list"; shift ;;
            --frames-cache) action="frames"; shift ;;
            --rule-only) action="ruleonly"; shift ;;
            --where)     action="where"; shift ;;
            --get)       [[ $# -ge 2 ]] || die "--get necesita una clave"; action="get"; getkey="$2"; shift 2 ;;
            --fps=*)     FPS="${1#*=}"; CLI_FPS=1; shift
                [[ "$FPS" =~ ^[0-9]+$ ]] || die "--fps 0-60 (0 = original)"
                FPS="$(clamp_int "$FPS" 0 60)" ;;
            --lock)      action="setlock"; newlock="yes"; shift ;;
            --unlock)    action="setlock"; newlock="no"; shift ;;
            -h|--help)   usage; exit 0 ;;
            -v|--version) printf 'gifdesk %s\n' "$VERSION"; exit 0 ;;
            --) shift; break ;;
            -*) die "opcion desconocida: $1 (usa --help)" ;;
            *)  if [[ -z "$FILE" ]]; then FILE="$1"; shift
                else die "archivo duplicado: $1"; fi ;;
        esac
    done

    select_instance

    case "$action" in
        stop)    if is_gnome_wayland; then gnome_cmd_stop; else cmd_stop; fi; exit 0 ;;
        status)  if is_gnome_wayland; then gnome_cmd_status; else cmd_status; fi; exit $? ;;
        list)    list_instances; exit 0 ;;
        frames)  scan_frames_cache; exit 0 ;;
        stopall) if is_gnome_wayland; then gnome_cmd_stop_all; else cmd_stop_all; fi; exit 0 ;;
        where)   if is_gnome_wayland; then gnome_cmd_where; else cmd_where; fi; exit $? ;;
        get)
            case "$getkey" in
                FILE|MODE|SIZE|POS|LOCKED|OPACITY|FPS|REV) ;;
                *) die "--get admite: FILE MODE SIZE POS LOCKED OPACITY FPS REV" ;;
            esac
            MODE="widget"; FILE=""; SIZE=""; POS=""; LOCKED="no"; OPACITY="100"; FPS="0"
            load_config
            case "$getkey" in
                FILE) printf '%s\n' "$FILE" ;;
                MODE) printf '%s\n' "$MODE" ;;
                SIZE) printf '%s\n' "$SIZE" ;;
                POS) printf '%s\n' "$POS" ;;
                LOCKED) printf '%s\n' "$LOCKED" ;;
                OPACITY) printf '%s\n' "$OPACITY" ;;
                FPS) printf '%s\n' "$FPS" ;;
                REV) printf '%s\n' "$(conf_rev "$CONFIG_FILE")" ;;
            esac
            exit 0 ;;
        setlock)
            if is_gnome_wayland; then
                gnome_cmd_lock "$newlock"; exit 0
            fi
            [[ -f "$CONFIG_FILE" ]] || die "sin instancia (muestra el GIF primero)"
            MODE="widget"; FILE=""; SIZE=""; POS=""; LOCKED="no"; OPACITY="100"; FPS="0"
            load_config
            if [[ "$LOCKED" != "$newlock" ]]; then
                sed -i "s/^[[:space:]]*LOCKED=.*/LOCKED=$newlock/" "$CONFIG_FILE"
                grep -qE '^[[:space:]]*LOCKED=' "$CONFIG_FILE" \
                    || echo "LOCKED=$newlock" >>"$CONFIG_FILE"
            fi
            if running_pid >/dev/null 2>&1; then
                run_autostart
                exit $?
            fi
            msg "guardado (se aplicara al mostrar)"
            exit 0 ;;
        ruleonly)
            if is_gnome_wayland; then
                gnome_cmd_ruleonly; exit 0
            fi
            MODE="widget"; FILE=""; SIZE=""; POS=""; LOCKED="no"; OPACITY="100"; FPS="0"
            load_config
            [[ -z "$FILE" || ! -f "$FILE" ]] && die "sin archivo para regla"
            [[ -z "$SIZE" ]] && SIZE="$(native_size "$FILE")"
            sync_placement "$POS" "$SIZE" "$OPACITY"
            msg "regla sincronizada (id=${IID:-main})"
            exit 0 ;;
    esac

    if [[ "$autostart" == "yes" ]]; then
        if [[ -z "$IID" ]]; then
            autostart_all; exit $?
        fi
        run_autostart; exit $?
    elif [[ "$autostart" == "legacy" ]]; then
        run_autostart; exit $?
    else
        load_config
    fi

    [[ "$MODE" =~ ^(widget|wallpaper)$ ]] || die "--mode debe ser widget|wallpaper"
    [[ -z "$FILE" ]] && { usage >&2; die "falta --file (ej: gifdesk --file ~/Descargas/rem.gif)"; }
    [[ -f "$FILE" ]] || die "no existe: $FILE"
    is_supported "$FILE" || die "solo .gif / .webp: $FILE"
    if is_gnome_wayland; then
        # En GNOME renderiza la extension (actores, no mpv ni ventanas).
        [[ "$MODE" == "wallpaper" ]] && die "--mode wallpaper no soportado en GNOME (usa widget)"
    else
        have mpv || die "falta mpv (instala con install.sh)"
    fi

    if [[ "$save" == "yes" ]]; then
        mkdir -p "$(dirname "$CONFIG_FILE")"
        # Ojo: reescribir pierde REV; se calcula antes para no romper la
        # cadena de revisiones (la regla solo se reescribe si REV cambia).
        local next_rev
        next_rev=$(( $(conf_rev "$CONFIG_FILE") + 1 ))
        {
            printf '# gifdesk — instancia %s (la usa --autostart)\n' "${IID:-main}"
            printf 'FILE="%s"\n' "$FILE"
            printf 'MODE=%s\nSIZE=%s\nPOS=%s\nLOCKED=%s\nREV=%s\nOPACITY=%s\nFPS=%s\n' \
                "$MODE" "$SIZE" "$POS" "$LOCKED" "$next_rev" "$OPACITY" \
                "$(clamp_int "$FPS" 0 60)"
        } >"$CONFIG_FILE"
        msg "config guardada: $CONFIG_FILE (rev $next_rev)"
    fi

    if [[ "$do_check" == "yes" ]]; then
        cmd_check "$FILE"
        exit $?
    fi

    if is_gnome_wayland; then
        if [[ "$dry" == "yes" ]]; then
            gnome_dry_run
            exit 0
        fi
        gnome_show_current
        exit 0
    fi

    launch "$FILE" "$MODE" "$SIZE" "$POS" "$dry"
}

main "$@"
